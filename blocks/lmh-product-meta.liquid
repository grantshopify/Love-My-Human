{%- comment -%}
  Brand row for the buy box: the vendor (or your own text) on the left, share icons on the right.
{%- endcomment -%}

{%- liquid
  assign b = block.settings
  assign p = closest.product
  assign share_url = shop.url | append: p.url | url_encode
  assign share_title = p.title | url_encode
  assign label = b.text | default: p.vendor
-%}

<div class="lmh-meta" style="--lmh-accent: {{ block.settings.accent_color | default: settings.color_palette.foreground }};" {{ block.shopify_attributes }}>
  {%- if b.show_vendor and label != blank -%}
    <p class="lmh-meta__vendor">{{ label }}</p>
  {%- endif -%}

  {%- if b.show_share -%}
    <ul class="lmh-meta__share list-unstyled" role="list">
      {%- if b.share_facebook -%}
        <li>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3H13.5V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4A21 21 0 0 0 14.3 4c-2.3 0-3.8 1.4-3.8 3.9v2.6H8v3h2.5V21h3Z"/></svg>
          </a>
        </li>
      {%- endif -%}
      {%- if b.share_x -%}
        <li>
          <a href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on X">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.2L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.3 5.7L17.8 3Zm-1 16.2h1.7L7.3 4.7H5.5l11.3 14.5Z"/></svg>
          </a>
        </li>
      {%- endif -%}
      {%- if b.share_pinterest -%}
        <li>
          <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}&media={{ p.featured_image | image_url: width: 1200 | prepend: 'https:' | url_encode }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Share on Pinterest">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12.2 3C7.3 3 4.8 6.5 4.8 9.4c0 1.8.7 3.4 2.1 4 .2.1.4 0 .5-.3l.2-.8c.1-.3 0-.4-.2-.6-.4-.5-.7-1.2-.7-2.1 0-2.7 2-5.1 5.3-5.1 2.9 0 4.4 1.8 4.4 4.1 0 3.1-1.4 5.7-3.4 5.7-1.1 0-2-.9-1.7-2.1.3-1.4 1-2.9 1-3.9 0-.9-.5-1.6-1.5-1.6-1.2 0-2.1 1.2-2.1 2.8 0 1 .3 1.7.3 1.7l-1.4 5.9c-.4 1.7-.1 3.9 0 4.1 0 .1.2.2.3.1.1-.1 1.4-1.8 1.9-3.4l.7-2.8c.4.7 1.4 1.3 2.6 1.3 3.4 0 5.7-3.1 5.7-7.2C19.5 6 16.8 3 12.2 3Z"/></svg>
          </a>
        </li>
      {%- endif -%}
      {%- if b.share_copy -%}
        <li>
          <button type="button" class="lmh-meta__copy" data-lmh-copy="{{ shop.url | append: p.url }}" aria-label="Copy link">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></svg>
            <span class="lmh-meta__copied" aria-live="polite"></span>
          </button>
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}
</div>

{%- if b.show_share and b.share_copy -%}
  <script>
    if (!window.lmhCopyLink) {
      window.lmhCopyLink = true;
      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-lmh-copy]');
        if (!button) return;
        const note = button.querySelector('.lmh-meta__copied');
        navigator.clipboard?.writeText(button.dataset.lmhCopy).then(() => {
          if (!note) return;
          note.textContent = 'Link copied';
          setTimeout(() => (note.textContent = ''), 2000);
        });
      });
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .lmh-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    inline-size: 100%;
  }

  .lmh-meta__vendor {
    margin: 0;
    color: var(--lmh-accent);
    font-family: var(--font-heading--family);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lmh-meta__share {
    display: flex;
    gap: 6px;
    margin: 0 0 0 auto;
    padding: 0;
  }

  .lmh-meta__share a,
  .lmh-meta__copy {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--lmh-accent);
    cursor: pointer;
    opacity: 0.7;
    transition:
      opacity 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .lmh-meta__share a:hover,
  .lmh-meta__copy:hover {
    background: var(--lmh-accent);
    color: var(--color-background);
    opacity: 1;
  }

  /* The "Link copied" note floats above the button, so it never pushes the icon off centre */
  .lmh-meta__copied {
    position: absolute;
    inset: auto 0 calc(100% + 6px) auto;
    pointer-events: none;
  }

  .lmh-meta__copied:empty {
    display: none;
  }

  .lmh-meta__copied:not(:empty) {
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--lmh-accent);
    color: var(--color-background);
    font-size: 11px;
    white-space: nowrap;
  }

  /* The product title under this row: smaller on phones and tablets so long names don't take over */
  @media screen and (max-width: 989px) {
    .product-details .text-block h1 {
      font-size: clamp(26px, 7vw, 32px);
      line-height: 1.1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand and share",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show brand",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Brand text",
      "info": "Leave empty to show the product's vendor."
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "share_facebook",
      "label": "Facebook",
      "default": true,
      "visible_if": "{{ block.settings.show_share }}"
    },
    {
      "type": "checkbox",
      "id": "share_x",
      "label": "X",
      "default": true,
      "visible_if": "{{ block.settings.show_share }}"
    },
    {
      "type": "checkbox",
      "id": "share_pinterest",
      "label": "Pinterest",
      "default": true,
      "visible_if": "{{ block.settings.show_share }}"
    },
    {
      "type": "checkbox",
      "id": "share_copy",
      "label": "Copy link",
      "default": true,
      "visible_if": "{{ block.settings.show_share }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "{{ settings.color_palette.foreground }}",
      "info": "Icons, lines and buttons. Defaults to the brand red."
    }
  ],
  "presets": [
    {
      "name": "Brand and share",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
