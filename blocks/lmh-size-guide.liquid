{%- comment -%}
  Size guide link: shows only when the product has a file in the "Size guide" metafield (custom.size_guide).
  Clicking it opens the guide in a pop-up (snippets/lmh-size-guide-link.liquid).
  When the size picker uses "Compact sizes" it shows the link next to "Size" itself, and this block hides (CSS below).
{%- endcomment -%}

{% render 'lmh-size-guide-link',
  product: closest.product,
  id: block.id,
  label: block.settings.label,
  class: 'lmh-size-guide--block',
  attributes: block.shopify_attributes
%}

{% stylesheet %}
  .product-details:has(.variant-picker .lmh-size-guide) .lmh-size-guide--block {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size guide",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Link text",
      "default": "Size Chart"
    },
    {
      "type": "paragraph",
      "content": "Shows only on products with a file in the \"Size guide\" metafield (custom.size_guide). Upload a PDF or an image there."
    }
  ],
  "presets": [
    {
      "name": "Size guide"
    }
  ]
}
{% endschema %}
