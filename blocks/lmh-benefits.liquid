{%- comment -%}
  Benefits: small icon + label points in the buy box (e.g. "Tested by our dogs", "Machine washable").
  Each point is a "Benefit" block inside this one, so they can be added, removed and reordered.
{%- endcomment -%}

<ul
  class="lmh-benefits list-unstyled"
  style="--lmh-benefit-columns: {{ block.settings.columns }}; --lmh-accent: {{ block.settings.accent_color | default: settings.color_palette.foreground }};"
  role="list"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</ul>

{% stylesheet %}
  .lmh-benefits {
    display: grid;
    grid-template-columns: repeat(var(--lmh-benefit-columns, 2), minmax(0, 1fr));
    gap: 12px 20px;
    inline-size: 100%;
    margin: 0;
    padding: 0;
  }

  .lmh-benefit {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--lmh-accent);
    font-family: var(--font-heading--family);
    font-size: 13px;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .lmh-benefit__icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border: 1px solid color-mix(in srgb, var(--lmh-accent) 35%, transparent);
    border-radius: 50%;
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      transform 0.6s cubic-bezier(0.2, 0, 0, 1);
  }

  .lmh-benefit:hover .lmh-benefit__icon {
    background: var(--lmh-accent);
    color: var(--color-background);
    transform: rotate(-8deg);
  }

  @media screen and (max-width: 339px) {
    .lmh-benefits {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefits",
  "tag": null,
  "blocks": [
    {
      "type": "_lmh-benefit"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "{{ settings.color_palette.foreground }}",
      "info": "Icons, lines and buttons. Defaults to the brand red."
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "category": "t:categories.product",
      "blocks": {
        "b1": { "type": "_lmh-benefit", "settings": { "icon": "paw", "text": "Tested by our dogs" } },
        "b2": { "type": "_lmh-benefit", "settings": { "icon": "home", "text": "Chosen in Chelsea" } },
        "b3": { "type": "_lmh-benefit", "settings": { "icon": "truck", "text": "Fast UK delivery" } },
        "b4": { "type": "_lmh-benefit", "settings": { "icon": "returns", "text": "14-day returns" } }
      },
      "block_order": ["b1", "b2", "b3", "b4"]
    }
  ]
}
{% endschema %}
