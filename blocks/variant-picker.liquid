

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}
{% endunless %}

{% stylesheet %}
  /* LMH "Compact sizes" (Zac 26 Nov, Cloud7 style): small square boxes, "Size: 3", Size Chart on the right */
  .variant-picker--lmh-compact .variant-option--buttons {
    position: relative;
  }

  .variant-picker--lmh-compact .variant-option--buttons:not(.variant-option--swatches) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .variant-picker--lmh-compact .variant-option--buttons legend {
    padding-inline-end: 110px;
    font-size: 13px;
  }

  .variant-picker--lmh-compact .lmh-compact-value {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .variant-picker--lmh-compact .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label {
    flex: 0 0 auto;
    min-inline-size: 40px;
    min-block-size: 40px;
    padding: 0 10px;
    justify-content: center;
    font-size: 13px;
  }

  .variant-picker--lmh-compact .lmh-size-guide--picker {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: auto;
    font-size: 13px;
  }

  .variant-picker--lmh-compact .lmh-size-guide--picker .lmh-size-guide__link {
    padding-bottom: 2px;
    border-bottom-width: 1px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "textarea",
      "id": "fallback_swatches",
      "label": "Swatch colours",
      "info": "One colour per line, like Pumpkin Velvet: #D9682B. Used for any colour that has no swatch set in Shopify.",
      "visible_if": "{{ block.settings.show_swatches }}"
    },
    {
      "type": "checkbox",
      "id": "lmh_compact",
      "label": "Compact sizes",
      "info": "Small square buttons (\"3\" instead of \"Size 3\"), the chosen value next to the label (\"Size: 3\") and the Size Chart link on the right of that line.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
