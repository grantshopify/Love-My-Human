{%- doc -%}
  Size guide link + pop-up for a product's "Size guide" metafield (custom.size_guide, a PDF or an image).
  Phones open a PDF in their own viewer; larger screens (and images) open the pop-up (Zac, 25 Nov 2026).
  Used by the Size guide block and, in the compact size picker, next to the "Size" label.

  @param {object} product - The product
  @param {string} id - Unique id for the pop-up
  @param {string} [label] - Link text, default "Size Chart"
  @param {string} [class] - Extra class on the wrapper
  @param {string} [attributes] - Extra attributes on the wrapper (block.shopify_attributes)
{%- enddoc -%}

{%- liquid
  assign label = label | default: 'Size Chart'
  assign guide = product.metafields.custom.size_guide.value
  assign guide_is_image = false
  assign guide_url = ''
  if guide != blank
    if guide.media_type == 'image'
      assign guide_is_image = true
      assign guide_url = guide | image_url: width: 1600
    else
      assign guide_url = guide.url
    endif
  endif
  assign dialog_id = 'LmhSizeGuide-' | append: id
-%}

{%- if guide_url != blank -%}
  <div class="lmh-size-guide {{ class }}" {{ attributes }}>
    <a
      href="{{ guide_url }}"
      target="_blank"
      rel="noopener"
      class="lmh-size-guide__link"
      aria-haspopup="dialog"
      aria-controls="{{ dialog_id }}"
      onclick="if ({{ guide_is_image }} || window.matchMedia('(min-width: 750px)').matches) { event.preventDefault(); document.getElementById('{{ dialog_id }}').showModal(); }"
    >
      <span>{{ label | escape }}</span>
    </a>

    <dialog id="{{ dialog_id }}" class="lmh-size-guide__dialog" aria-label="{{ label | escape }}" onclick="if (event.target === this) this.close()">
      <div class="lmh-size-guide__panel">
        <div class="lmh-size-guide__header">
          <p class="lmh-size-guide__title">{{ label | escape }}</p>
          <button type="button" class="lmh-size-guide__close" aria-label="Close" onclick="this.closest('dialog').close()">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        {%- if guide_is_image -%}
          {%- assign guide_alt = guide.alt | default: label -%}
          {{ guide | image_url: width: 1600 | image_tag: class: 'lmh-size-guide__image', loading: 'lazy', alt: guide_alt }}
        {%- else -%}
          <iframe class="lmh-size-guide__frame" src="{{ guide_url }}#view=FitH" title="{{ label | escape }}" loading="lazy"></iframe>
          <a class="lmh-size-guide__open" href="{{ guide_url }}" target="_blank" rel="noopener">Open the PDF</a>
        {%- endif -%}
      </div>
    </dialog>
  </div>
{%- endif -%}

{% stylesheet %}
  .lmh-size-guide {
    inline-size: 100%;
  }

  .lmh-size-guide__link {
    display: inline-block;
    padding: 0 0 5px;
    border: 0;
    border-bottom: 1.5px solid currentColor;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
  }

  .lmh-size-guide__dialog {
    inline-size: min(920px, calc(100vw - 32px));
    max-block-size: calc(100dvh - 48px);
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--color-background, #fff);
    color: var(--color-foreground, inherit);
  }

  .lmh-size-guide__dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .lmh-size-guide__panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 20px 20px;
  }

  .lmh-size-guide__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .lmh-size-guide__title {
    margin: 0;
    font-weight: 600;
  }

  .lmh-size-guide__close {
    display: inline-flex;
    padding: 6px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .lmh-size-guide__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    max-block-size: calc(100dvh - 140px);
    object-fit: contain;
  }

  .lmh-size-guide__frame {
    inline-size: 100%;
    block-size: min(70dvh, 760px);
    border: 0;
  }

  .lmh-size-guide__open {
    align-self: center;
    text-decoration: underline;
  }
{% endstylesheet %}
