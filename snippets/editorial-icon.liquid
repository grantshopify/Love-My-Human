{%- doc -%}
  Thin line icons (24×24, stroke = currentColor) for the FAQ sidebar badges and the
  reassurance columns. Keep the option list in sync with the "icon" selects in
  sections/faq-editorial.liquid and sections/reassurance-columns.liquid.

  @param {string} icon - Icon name
  @param {number} [size] - Rendered size in px, default 24
{%- enddoc -%}

{%- assign size = size | default: 24 -%}
{%- capture paths -%}
  {%- case icon -%}
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 4.5-5.5 8-5.5s6.5 1.5 8 5.5"/>
    {%- when 'box' -%}
      <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
    {%- when 'paw' -%}
      <ellipse cx="7" cy="9.5" rx="1.6" ry="2.2"/><ellipse cx="10.5" cy="6.5" rx="1.6" ry="2.2"/><ellipse cx="14.5" cy="6.5" rx="1.6" ry="2.2"/><ellipse cx="18" cy="9.5" rx="1.6" ry="2.2"/><path d="M12.5 11c-3 0-5.5 4-5.5 6.2 0 1.6 1.3 2.3 2.8 2.3 1.2 0 1.8-.6 2.7-.6s1.5.6 2.7.6c1.5 0 2.8-.7 2.8-2.3 0-2.2-2.5-6.2-5.5-6.2Z"/>
    {%- when 'home' -%}
      <path d="m3 11 9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>
    {%- when 'truck' -%}
      <path d="M2 6h12v10H2z"/><path d="M14 9h4l3 3.5V16h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'returns' -%}
      <path d="M4 9h13l-3-3"/><path d="M20 15H7l3 3"/>
    {%- when 'phone' -%}
      <path d="M6.5 3.5 9 4l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5.5 2.5c-.3 1.5-1.8 2.5-3.3 2.3C10.3 19 5 13.7 4.2 6.8 4 5.3 5 3.8 6.5 3.5Z"/>
    {%- when 'card' -%}
      <rect x="2.5" y="5" width="16" height="11" rx="1.5"/><path d="M2.5 9h16"/><rect x="14.5" y="14" width="7" height="6" rx="1"/><path d="M16 14v-1.5a2 2 0 0 1 4 0V14"/>
    {%- when 'gift' -%}
      <rect x="3" y="9" width="18" height="4"/><path d="M5 13v8h14v-8M12 9v12"/><path d="M12 9c-1-3-5-4.5-5-1.5C7 9 12 9 12 9Zm0 0c1-3 5-4.5 5-1.5C17 9 12 9 12 9Z"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4V5Z"/>
    {%- when 'question' -%}
      <circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7v.5"/><path d="M12 17h.01"/>
    {%- when 'scissors' -%}
      <circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="m8 8.5 12 9M8 15.5l12-9"/>
    {%- when 'cup' -%}
      <path d="M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3v2M12 3v2"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6L12 3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'store' -%}
      <path d="M4 9.5 5.5 4h13L20 9.5"/><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0"/><path d="M5 11v9h14v-9"/><path d="M10 20v-5h4v5"/>
  {%- endcase -%}
{%- endcapture -%}

{%- if paths != blank -%}
  <svg
    class="editorial-icon"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="{{ size }}"
    height="{{ size }}"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {{- paths -}}
  </svg>
{%- endif -%}
