{%- comment -%}
  Journal with calendar dates ("News"): the latest blog posts as cards, each with a red date block on the photo,
  the title (underlined on hover) and a short excerpt. "All articles" links to the blog.
  Phones: a swipe row, or the cards stacked.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign blog = s.blog

  if s.animate
    assign reveal = 'data-reveal'
  endif

  assign columns = s.columns_desktop
  assign sizes = '(min-width: 750px) calc(min(100vw - 48px, ' | append: s.max_width | append: 'px) / ' | append: columns | append: '), 82vw'
-%}

{%- if s.animate -%}{% render 'editorial-reveal' %}{%- endif -%}

<div
  class="jn jn--mobile-{{ s.mobile_layout }}"
  style="
    --jn-background: {{ s.background_color | default: settings.color_palette.background }};
    --jn-accent: {{ s.accent_color | default: settings.color_palette.foreground }};
    --jn-text: {{ s.text_color | default: settings.color_palette.color1 }};
    --jn-date-text: {{ s.date_text_color | default: settings.color_palette.background }};
    --jn-heading-size: {{ s.heading_size }}px;
    --jn-columns: {{ columns }};
    --jn-width: {{ s.max_width }}px;
    --jn-radius: {{ s.radius }}px;
    --jn-padding-top: {{ s.padding_top }}px;
    --jn-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="jn__inner">
    <div class="jn__intro" {{ reveal }}>
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="jn__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="jn__heading">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank and blog != blank -%}
        <a class="jn__more" href="{{ blog.url }}">
          {{- s.link_label -}}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-5-5 5 5-5 5"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="jn__list list-unstyled" role="list">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: s.post_limit -%}
          <li class="jn__item" {{ reveal }}>
            <a class="jn__card" href="{{ article.url }}">
              <span class="jn__media">
                {%- if article.image != blank -%}
                  {{
                    article.image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'jn__image',
                      loading: 'lazy',
                      alt: article.image.alt | default: article.title,
                      widths: '300, 450, 600, 800, 1000',
                      sizes: sizes
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'jn__image jn__image--placeholder' }}
                {%- endif -%}
                {%- if s.show_date -%}
                  <time class="jn__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    <span class="jn__day">{{ article.published_at | date: '%d' }}</span>
                    <span class="jn__month">{{ article.published_at | date: '%b' }}</span>
                  </time>
                {%- endif -%}
              </span>
              <span class="jn__body">
                <span class="jn__title"><span class="jn__title-line">{{ article.title }}</span></span>
                {%- if s.show_excerpt -%}
                  {%- assign excerpt = article.excerpt | default: article.content | strip_html | truncatewords: s.excerpt_words -%}
                  {%- if excerpt != blank -%}
                    <span class="jn__excerpt">{{ excerpt }}</span>
                  {%- endif -%}
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} No blog picked yet: placeholder cards so the layout shows in the editor {%- endcomment -%}
        {%- for i in (1..3) -%}
          <li class="jn__item">
            <span class="jn__card">
              <span class="jn__media">
                {{ 'image' | placeholder_svg_tag: 'jn__image jn__image--placeholder' }}
                <span class="jn__date"><span class="jn__day">0{{ i }}</span><span class="jn__month">Jan</span></span>
              </span>
              <span class="jn__body"><span class="jn__title">Article title</span></span>
            </span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .jn {
    padding: var(--jn-padding-top) 16px var(--jn-padding-bottom);
    background: var(--jn-background);
    color: var(--jn-text);
    font-family: var(--font-body--family);
  }

  .jn__inner {
    max-inline-size: var(--jn-width);
    margin: 0 auto;
  }

  .jn__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-block-end: 24px;
  }

  .jn__eyebrow {
    margin: 0 0 6px;
    color: var(--jn-accent);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .jn__heading {
    margin: 0;
    color: var(--jn-accent);
    font-family: var(--font-heading--family);
    font-size: min(calc(var(--jn-heading-size) * 0.85), 30px);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .jn__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-block-end: 4px;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
    color: var(--jn-accent);
    font-family: var(--font-heading--family);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-size 0.5s cubic-bezier(0.2, 0, 0, 1);
  }

  .jn__more:hover {
    background-position: right bottom;
    background-size: 0 1px;
  }

  .jn__list {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .jn__item {
    min-inline-size: 0;
  }

  .jn__card {
    display: grid;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }

  /* The photo leaves room underneath for the date block, which hangs over its bottom edge */
  .jn__media {
    position: relative;
    display: block;
    margin-block-end: 20px;
  }

  .jn__image {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1;
    border-radius: var(--jn-radius);
    object-fit: cover;
  }

  .jn__image--placeholder {
    background: color-mix(in srgb, var(--jn-accent) 12%, #fff);
    fill: var(--jn-accent);
  }

  .jn__date {
    position: absolute;
    inset-block-end: -18px;
    inset-inline-start: 14px;
    display: grid;
    justify-items: center;
    inline-size: 60px;
    padding: 8px 0;
    border-radius: 10px;
    background: var(--jn-accent);
    color: var(--jn-date-text);
    box-shadow: 0 8px 18px -10px rgb(0 0 0 / 0.5);
    text-align: center;
  }

  .jn__day {
    font-family: var(--font-heading--family);
    font-size: 26px;
    line-height: 1;
  }

  .jn__month {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .jn__body {
    display: grid;
    gap: 8px;
  }

  /* Titles always take two lines (longer ones end in "…"), so the excerpts line up across the cards */
  .jn__title {
    display: -webkit-box;
    min-block-size: 2.4em;
    overflow: hidden;
    color: var(--jn-accent);
    font-family: var(--font-heading--family);
    font-size: 19px;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* The underline draws in under the title on hover */
  .jn__title-line {
    background: linear-gradient(currentColor, currentColor) left bottom / 0 2px no-repeat;
    transition: background-size 0.5s cubic-bezier(0.2, 0, 0, 1);
  }

  .jn__card:hover .jn__title-line {
    background-size: 100% 2px;
  }

  .jn__card:focus-visible {
    outline: 2px solid var(--jn-accent);
    outline-offset: 4px;
    border-radius: var(--jn-radius);
  }

  .jn__excerpt {
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.8;
  }

  /* Phones, swipe row: cards scroll sideways and run to the screen edge */
  @media screen and (max-width: 749px) {
    .jn {
      padding-block: min(var(--jn-padding-top), 48px) min(var(--jn-padding-bottom), 48px);
    }

    .jn--mobile-swipe .jn__list {
      grid-auto-columns: 82%;
      grid-auto-flow: column;
      gap: 14px;
      margin-inline: -16px;
      padding-inline: 16px;
      overflow-x: auto;
      scroll-padding-inline: 16px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .jn--mobile-swipe .jn__list::-webkit-scrollbar {
      display: none;
    }

    .jn--mobile-swipe .jn__item {
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 750px) {
    .jn {
      padding-inline: 24px;
    }

    .jn__intro {
      margin-block-end: 32px;
    }

    .jn__heading {
      font-size: min(var(--jn-heading-size), 40px);
    }

    .jn__list {
      grid-template-columns: repeat(var(--jn-columns), minmax(0, 1fr));
      gap: 40px 24px;
    }

    .jn__title {
      font-size: 21px;
    }
  }

  @media screen and (min-width: 990px) {
    .jn__heading {
      font-size: var(--jn-heading-size);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jn__title-line {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Journal with dates",
  "tag": "section",
  "class": "journal-calendar-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of articles",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "The journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Townhouse"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link to the blog",
      "default": "All articles",
      "info": "Leave empty to hide it."
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "info": "The date the article was published. Change it in Online Store > Blog posts.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "label": "Excerpt length",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "w",
      "default": 18,
      "info": "Used when an article has no excerpt of its own.",
      "visible_if": "{{ section.settings.show_excerpt }}"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "On mobile",
      "options": [
        {
          "value": "swipe",
          "label": "Swipe row"
        },
        {
          "value": "stack",
          "label": "Stacked"
        }
      ],
      "default": "swipe"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Headings and date blocks",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "date_text_color",
      "label": "Date text",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Excerpt text",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Journal with dates",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
