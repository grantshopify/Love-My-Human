{%- comment -%}
  Wholesale account: the page title, a log in link and the BSS B2B app's sign-up form (from the page content).
  The app only shows its form on its own page, /pages/wholesale-account-registration.
{%- endcomment -%}

<div class="wa page-width">
  <h1>{{ page.title }}</h1>
  <p>Already have a trade account? <a href="{{ routes.account_login_url }}">Log in</a></p>
  {{ page.content }}
</div>

{% stylesheet %}
  .wa {
    padding: 40px var(--page-margin, 16px) 80px;
  }

  /* The app's form is a fixed 600px wide; keep it on screen on phones */
  .wa :is(#bss-b2b-registration-form, #bss-b2b-register-form) {
    /* stylelint-disable-next-line declaration-no-important */
    width: 100% !important;
    max-inline-size: 600px;
    margin-inline: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wholesale account",
  "tag": "section"
}
{% endschema %}
