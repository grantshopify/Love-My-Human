{%- comment -%}
  Collection intro (SEO): breadcrumb, the collection title, then the "Intro SEO copy" for this collection.
  The copy comes from the collection's rich text metafield custom.intro_seo_copy (Products > Collections > a collection
  > Metafields), so every collection has its own. Without it, the collection description shows instead.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign c = collection

  # The collection's own intro copy, or its description until the copy is written
  assign intro = c.metafields.custom.intro_seo_copy | metafield_tag
  if intro == blank and s.fallback_to_description
    assign intro = c.description
  endif

  # Links to the store's own pages become on-site links (the admin link box needs a full https:// address)
  assign own_domain = 'href="https://' | append: shop.permanent_domain
  assign live_domain = 'href="' | append: shop.url
  assign intro = intro | replace: own_domain, 'href="' | replace: live_domain, 'href="'

  assign heading = c.title
  if s.heading != blank
    assign heading = s.heading
  endif
-%}

<div
  class="csi csi--{{ s.alignment }}"
  style="
    --csi-background: {{ s.background_color | default: settings.color_palette.background }};
    --csi-accent: {{ s.accent_color | default: settings.color_palette.foreground }};
    --csi-text: {{ s.text_color | default: settings.color_palette.color1 }};
    --csi-heading-size: {{ s.heading_size }}px;
    --csi-text-width: {{ s.text_width }}px;
    --csi-padding-top: {{ s.padding_top }}px;
    --csi-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="csi__inner">
    {%- if s.show_breadcrumb -%}
      <nav class="csi__breadcrumb" aria-label="Breadcrumb">
        <ol class="list-unstyled" role="list">
          <li><a href="{{ routes.root_url }}">{{ s.home_label | default: 'Home' }}</a></li>
          <li aria-current="page">{{ c.title }}</li>
        </ol>
      </nav>
      {%- comment -%} Breadcrumb for search results {%- endcomment -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": {{ s.home_label | default: 'Home' | json }}, "item": {{ shop.url | append: routes.root_url | json }} },
            { "@type": "ListItem", "position": 2, "name": {{ c.title | json }}, "item": {{ shop.url | append: c.url | json }} }
          ]
        }
      </script>
    {%- endif -%}

    <h1 class="csi__heading">{{ heading }}</h1>

    {%- if intro != blank -%}
      <div class="csi__copy">{{ intro }}</div>
    {%- elsif request.design_mode -%}
      <p class="csi__hint">
        Add this collection's intro in Products &gt; Collections &gt; {{ c.title }} &gt; Metafields &gt; Intro SEO copy.
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .csi {
    padding: var(--csi-padding-top) var(--page-margin, 16px) var(--csi-padding-bottom);
    background: var(--csi-background);
    color: var(--csi-text);
    font-family: var(--font-body--family);
  }

  .csi__inner {
    margin: 0 auto;
  }

  .csi--center .csi__inner {
    text-align: center;
  }

  .csi--center .csi__copy,
  .csi--center .csi__hint {
    margin-inline: auto;
  }

  .csi__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0 0 14px;
    padding: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .csi--center .csi__breadcrumb ol {
    justify-content: center;
  }

  .csi__breadcrumb li + li::before {
    content: '|';
    margin-inline: 8px;
    opacity: 0.5;
  }

  .csi__breadcrumb a {
    color: inherit;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .csi__breadcrumb a:hover {
    opacity: 1;
  }

  .csi__heading {
    margin: 0 0 12px;
    color: var(--csi-accent);
    font-family: var(--font-heading--family);
    font-size: min(calc(var(--csi-heading-size) * 0.75), 34px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  /* The copy is rich text from the metafield: subtitles, paragraphs, lists and links */
  .csi__copy {
    max-inline-size: var(--csi-text-width);
    font-size: 15px;
    line-height: 1.65;
  }

  .csi__copy > * {
    margin: 0 0 12px;
  }

  .csi__copy > :last-child {
    margin-block-end: 0;
  }

  .csi__copy :is(h2, h3, h4, h5, h6) {
    margin-block-end: 8px;
    color: var(--csi-accent);
    font-family: var(--font-body--family);
    font-size: 16px;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    text-transform: none;
  }

  .csi__copy em {
    color: var(--csi-accent);
  }

  .csi__copy a {
    color: var(--csi-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .csi__copy a:hover {
    text-decoration-color: transparent;
  }

  .csi__copy ul,
  .csi__copy ol {
    padding-inline-start: 20px;
  }

  .csi__hint {
    max-inline-size: var(--csi-text-width);
    margin: 0;
    padding: 12px 16px;
    border: 1px dashed color-mix(in srgb, var(--csi-accent) 50%, transparent);
    border-radius: 8px;
    font-size: 13px;
  }

  @media screen and (min-width: 750px) {
    .csi__heading {
      font-size: min(var(--csi-heading-size), 44px);
    }

    .csi__copy {
      font-size: 16px;
    }
  }

  @media screen and (min-width: 990px) {
    .csi__heading {
      font-size: var(--csi-heading-size);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection intro (SEO)",
  "tag": "section",
  "class": "collection-seo-intro-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The text is set per collection: Products > Collections > a collection > Metafields > \"Intro SEO copy\"."
    },
    {
      "type": "checkbox",
      "id": "fallback_to_description",
      "label": "Show the collection description when there is no intro",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the collection title."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "info": "\"Home | Collection\" above the heading. Also tells Google where the page sits.",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home",
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 480,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading and links",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Collection intro (SEO)",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
