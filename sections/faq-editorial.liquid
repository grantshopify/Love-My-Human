{%- comment -%}
  FAQ (Hermès style): sidebar of groups and topics on the left, the selected topic's questions
  as an accordion on the right, and a "More questions?" contact box underneath.

  Everything is managed with blocks, in order:
    Group    → a heading in the sidebar (e.g. "Online shopping")
    Topic    → a link under the group and the title above its questions (e.g. "Delivery")
    Question → belongs to the topic above it
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # Colours: two presets from the theme palette, or the custom pickers
  assign palette = settings.color_palette
  case s.color_style
    when 'neutral'
      assign faq_background = palette.background
      assign faq_card = '#FFFFFF'
      assign faq_text = palette.color1
      assign faq_muted = palette.color1
    when 'custom'
      assign faq_background = s.background_color
      assign faq_card = s.card_color
      assign faq_text = s.text_color
      assign faq_muted = s.muted_color
    else
      assign faq_background = palette.background
      assign faq_card = '#FFFFFF'
      assign faq_text = palette.foreground
      assign faq_muted = palette.foreground
  endcase

  assign has_topic = false
  for block in section.blocks
    if block.type == 'topic'
      assign has_topic = true
      break
    endif
  endfor
-%}

<faq-editorial
  class="faq-editorial{% if s.layout == 'simple' %} faq-editorial--simple{% endif %}"
  data-single-open="{{ s.single_open }}"
  data-open-first="{{ s.open_first }}"
  data-layout="{{ s.layout }}"
  data-single-group="{{ s.single_group }}"
  style="
    --faq-background: {{ faq_background }};
    --faq-card: {{ faq_card }};
    --faq-text: {{ faq_text }};
    --faq-muted: {{ faq_muted }};
    --faq-padding-top: {{ s.padding_top }}px;
    --faq-column-gap: {{ s.column_gap }}px;
    --faq-simple-width: {{ s.simple_width }}px;
    --faq-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="faq-editorial__inner">
    {%- if has_topic and s.layout != 'simple' -%}
      <nav class="faq-editorial__sidebar" aria-label="{{ s.sidebar_label | escape }}">
        {%- if s.back_label != blank and s.back_link != blank -%}
          <a class="faq-editorial__back" href="{{ s.back_link }}">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="12" height="12"><path d="m13 4-6 6 6 6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
            {{ s.back_label }}
          </a>
        {%- endif -%}

        {%- comment -%} Mobile: a button showing the current topic opens the topic list {%- endcomment -%}
        <button type="button" class="faq-editorial__picker" aria-expanded="false" data-faq-picker>
          <span data-faq-picker-label></span>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="12" height="12"><path d="m4 7 6 6 6-6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
        </button>

        <div class="faq-editorial__menu" data-faq-menu>
          {%- comment -%} Topics placed before any Group are listed on their own {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'group' -%}{%- break -%}{%- endif -%}
            {%- if block.type == 'topic' -%}
              {%- assign topic_id = block.settings.title | handleize -%}
              <a class="faq-editorial__topic" href="#{{ topic_id }}" data-faq-topic-link="{{ topic_id }}" {{ block.shopify_attributes }}>
                {{- block.settings.title -}}
              </a>
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Each Group is an accordion card holding the Topics that follow it {%- endcomment -%}
          {%- for group in section.blocks -%}
            {%- if group.type != 'group' -%}{%- continue -%}{%- endif -%}
            {%- assign group_index = forloop.index0 -%}
            <details class="faq-editorial__group-card" data-faq-group{% if group.settings.open %} open{% endif %} {{ group.shopify_attributes }}>
              <summary class="faq-editorial__group">
                {%- if group.settings.icon_image != blank or group.settings.icon != 'none' -%}
                  <span class="faq-editorial__group-icon">
                    {%- if group.settings.icon_image != blank -%}
                      {{ group.settings.icon_image | image_url: width: 80 | image_tag: width: 20, height: 20, alt: '', loading: 'lazy' }}
                    {%- else -%}
                      {% render 'editorial-icon', icon: group.settings.icon, size: 20 %}
                    {%- endif -%}
                  </span>
                {%- endif -%}
                <span class="faq-editorial__group-title">{{ group.settings.title }}</span>
                <svg class="faq-editorial__chevron" aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="14" height="14"><path d="m4 7 6 6 6-6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
              </summary>
              <div class="faq-editorial__group-topics" data-faq-collapsible>
                <div class="faq-editorial__group-topics-inner">
                {%- assign in_group = false -%}
                {%- for block in section.blocks -%}
                  {%- if forloop.index0 == group_index -%}
                    {%- assign in_group = true -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- if in_group and block.type == 'group' -%}{%- break -%}{%- endif -%}
                  {%- if in_group and block.type == 'topic' -%}
                    {%- assign topic_id = block.settings.title | handleize -%}
                    <a class="faq-editorial__topic" href="#{{ topic_id }}" data-faq-topic-link="{{ topic_id }}" {{ block.shopify_attributes }}>
                      {{- block.settings.title -}}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              </div>
            </details>
          {%- endfor -%}
        </div>
      </nav>
    {%- endif -%}

    {%- comment -%}
      Each title and question carries the topic it belongs to (the Topic block above it);
      the script shows the selected topic's title and questions.
    {%- endcomment -%}
    <div class="faq-editorial__content">
      {%- assign current_topic = 'faq' -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'topic' -%}
            {%- assign current_topic = block.settings.title | handleize -%}
            <h2
              class="faq-editorial__title"
              id="{{ current_topic }}"
              data-faq-topic="{{ current_topic }}"
              data-faq-title
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title }}
            </h2>
          {%- when 'question' -%}
            <details
              class="faq-editorial__item"
              id="faq-{{ block.id }}"
              data-faq-topic="{{ current_topic }}"
              {{ block.shopify_attributes }}
            >
              <summary class="faq-editorial__question">
                <h3 class="faq-editorial__question-text">{{ block.settings.question }}</h3>
                <span class="faq-editorial__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq-editorial__answer" data-faq-collapsible>
                <div class="faq-editorial__answer-inner rte">
                  {{ block.settings.answer }}
                  {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
                  {%- if block.settings.bullets != blank -%}
                    <ul class="faq-editorial__bullets">
                      {%- for line in bullet_lines -%}
                        {%- assign bullet_text = line | strip -%}
                        {%- if bullet_text != blank -%}<li>{{ bullet_text }}</li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {{ block.settings.answer_after }}
                </div>
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <p class="faq-editorial__empty">Add a Group, then Topics and Questions in the section's blocks.</p>
      {%- endif -%}
    </div>
  </div>

  {%- if s.contact_heading != blank or s.contact_text != blank or s.contact_image != blank -%}
    <div class="faq-editorial__contact-wrap{% if s.contact_image != blank %} faq-editorial__contact-wrap--image{% endif %}" style="--faq-banner-height: {{ s.contact_image_height }}px;">
    {%- if s.contact_image != blank -%}
      {%- capture banner_style -%}object-position: {{ s.contact_image.presentation.focal_point | default: 'center' }};{%- endcapture -%}
      {{
        s.contact_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '(min-width: 1340px) 1260px, 100vw',
          alt: s.contact_image.alt,
          loading: 'lazy',
          class: 'faq-editorial__banner',
          style: banner_style
      }}
    {%- endif -%}
    <div class="faq-editorial__contact">
      {%- if s.contact_heading != blank -%}
        <h2 class="faq-editorial__contact-heading">{{ s.contact_heading }}</h2>
      {%- endif -%}
      {%- if s.contact_text != blank -%}
        <div class="faq-editorial__contact-text rte">{{ s.contact_text }}</div>
      {%- endif -%}
      {%- if s.contact_button_label != blank and s.contact_button_link != blank -%}
        <a class="button faq-editorial__contact-button" href="{{ s.contact_button_link }}">{{ s.contact_button_label }}</a>
      {%- endif -%}

      {%- if s.show_form -%}
        {%- assign form_id = 'FaqContactForm-' | append: section.id -%}
        {%- form 'contact', id: form_id, class: 'faq-editorial__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="faq-editorial__form-status" role="status">{{ s.form_success }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <div class="faq-editorial__form-status faq-editorial__form-status--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="faq-editorial__fields">
              {%- if s.form_show_name -%}
                <div class="faq-editorial__field">
                  <label for="{{ form_id }}-name">{{ s.form_name_label }}{% if s.form_name_required %} *{% endif %}</label>
                  <input id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" placeholder="{{ s.form_name_placeholder | escape }}"{% if s.form_name_required %} required{% endif %}>
                </div>
              {%- endif -%}
              <div class="faq-editorial__field">
                <label for="{{ form_id }}-email">{{ s.form_email_label }} *</label>
                <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" value="{{ form.email }}" placeholder="{{ s.form_email_placeholder | escape }}" required>
              </div>
              {%- if s.form_show_phone -%}
                <div class="faq-editorial__field">
                  <label for="{{ form_id }}-phone">{{ s.form_phone_label }}{% if s.form_phone_required %} *{% endif %}</label>
                  <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}" placeholder="{{ s.form_phone_placeholder | escape }}"{% if s.form_phone_required %} required{% endif %}>
                </div>
              {%- endif -%}
              {%- assign topic_options = s.form_topic_options | newline_to_br | split: '<br />' -%}
              {%- if s.form_show_topic and s.form_topic_options != blank -%}
                <div class="faq-editorial__field">
                  <label for="{{ form_id }}-topic">{{ s.form_topic_label }}</label>
                  <div class="faq-editorial__select">
                  <select id="{{ form_id }}-topic" name="contact[{{ s.form_topic_label | escape }}]">
                    {%- for option in topic_options -%}
                      {%- assign option_text = option | strip -%}
                      {%- if option_text != blank -%}<option value="{{ option_text | escape }}">{{ option_text }}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                  </div>
                </div>
              {%- endif -%}
              <div class="faq-editorial__field faq-editorial__field--full">
                <label for="{{ form_id }}-message">{{ s.form_message_label }} *</label>
                <textarea id="{{ form_id }}-message" name="contact[body]" rows="5" placeholder="{{ s.form_message_placeholder | escape }}" required>{{ form.body }}</textarea>
              </div>
            </div>
            {%- if s.form_note != blank -%}
              <div class="faq-editorial__form-note rte">{{ s.form_note }}</div>
            {%- endif -%}
            <button type="submit" class="button faq-editorial__form-submit">{{ s.form_submit_label }}</button>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
    </div>
  {%- endif -%}
</faq-editorial>

<script>
  if (!customElements.get('faq-editorial')) {
    customElements.define(
      'faq-editorial',
      class extends HTMLElement {
        connectedCallback() {
          this.items = [...this.querySelectorAll('.faq-editorial__content [data-faq-topic]')];
          this.topics = [...new Set(this.items.map((item) => item.dataset.faqTopic))];
          this.links = [...this.querySelectorAll('[data-faq-topic-link]')];
          this.picker = this.querySelector('[data-faq-picker]');
          this.pickerLabel = this.querySelector('[data-faq-picker-label]');

          this.links.forEach((link) =>
            link.addEventListener('click', (event) => {
              event.preventDefault();
              this.show(link.dataset.faqTopicLink, true);
              this.picker?.setAttribute('aria-expanded', 'false');
            })
          );

          this.picker?.addEventListener('click', () => {
            const open = this.picker.getAttribute('aria-expanded') === 'true';
            this.picker.setAttribute('aria-expanded', String(!open));
          });

          // Smooth accordions: questions and sidebar groups slide open and closed
          this.addEventListener('click', (event) => {
            const summary = event.target.closest('summary');
            const details = summary?.parentElement;
            if (!(details instanceof HTMLDetailsElement) || !this.contains(details)) return;
            if (!details.querySelector(':scope > [data-faq-collapsible]')) return;
            event.preventDefault();
            const opening = !details.open;
            this.animate(details, opening);
            // Sidebar: only one group card open at a time
            if (opening && details.matches('[data-faq-group]') && this.dataset.singleGroup === 'true') {
              this.querySelectorAll('details[data-faq-group][open]').forEach((other) => {
                if (other !== details) this.animate(other, false);
              });
            }
            // One question open at a time (optional)
            if (opening && this.dataset.singleOpen === 'true' && details.dataset.faqTopic) {
              this.querySelectorAll(`details[open][data-faq-topic="${details.dataset.faqTopic}"]`).forEach((other) => {
                if (other !== details) this.animate(other, false);
              });
            }
          });

          // Theme editor: show the topic of the block being edited
          document.addEventListener('shopify:block:select', (event) => {
            if (!this.contains(event.target)) return;
            const id = event.target.dataset?.faqTopic || event.target.dataset?.faqTopicLink;
            if (id) this.show(id, false);
            if (event.target instanceof HTMLDetailsElement) event.target.open = true;
          });

          window.addEventListener('hashchange', () => this.fromHash());
          this.fromHash(true);
        }

        /** Opens the topic (or question) named in the URL, e.g. /pages/faq#delivery */
        fromHash(initial = false) {
          const hash = decodeURIComponent(location.hash.slice(1));
          const target = hash && this.querySelector(`#${CSS.escape(hash)}`);
          this.show(target?.dataset?.faqTopic || this.topics[0], false);
          if (target instanceof HTMLDetailsElement) {
            target.open = true;
            target.scrollIntoView({ block: 'center' });
          } else if (initial && this.dataset.openFirst === 'true') {
            const firstQuestion = this.querySelector('details[data-faq-topic]:not([hidden])');
            if (firstQuestion) firstQuestion.open = true;
          }
        }

        /** Slides a <details> open or closed by animating its collapsible content's height */
        animate(details, open) {
          const content = details.querySelector(':scope > [data-faq-collapsible]');
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          content?.getAnimations().forEach((animation) => animation.cancel());
          if (!content || reduce) {
            details.open = open;
            return;
          }
          const easing = 'cubic-bezier(0.2, 0, 0, 1)';
          // Each call gets a token so a late "close" never shuts a details that was re-opened
          const token = (details.faqToken = Symbol());
          if (open) {
            details.open = true;
            const height = content.scrollHeight;
            const animation = content.animate(
              [
                { height: '0px', opacity: 0 },
                { height: `${height}px`, opacity: 1 },
              ],
              { duration: 350, easing }
            );
            // Backup: if the animation stalls, never leave the content hidden
            setTimeout(() => {
              if (details.faqToken === token) animation.cancel();
            }, 400);
          } else {
            const height = content.offsetHeight;
            const animation = content.animate(
              [
                { height: `${height}px`, opacity: 1 },
                { height: '0px', opacity: 0 },
              ],
              { duration: 280, easing }
            );
            const finish = () => {
              if (details.faqToken !== token) return;
              details.open = false;
              animation.cancel();
            };
            animation.onfinish = finish;
            // Backup: animations can stall (background tabs), so close when the time is up anyway
            setTimeout(finish, 320);
          }
        }

        show(id, updateUrl) {
          if (!id) return;
          // "Questions only" layout: every topic stays visible, there is nothing to switch
          if (this.dataset.layout === 'simple') return;
          this.items.forEach((item) => (item.hidden = item.dataset.faqTopic !== id));
          this.links.forEach((link) => {
            const active = link.dataset.faqTopicLink === id;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
          // Open the sidebar group that holds the current topic
          const activeLink = this.links.find((link) => link.dataset.faqTopicLink === id);
          const group = activeLink?.closest('[data-faq-group]');
          if (group && !group.open) group.open = true;
          if (group && this.dataset.singleGroup === 'true') {
            this.querySelectorAll('details[data-faq-group][open]').forEach((other) => {
              if (other !== group) other.open = false;
            });
          }
          const title = this.items.find((item) => item.matches('[data-faq-title]') && item.dataset.faqTopic === id);
          if (this.pickerLabel) this.pickerLabel.textContent = title?.textContent.trim() || '';
          if (updateUrl) history.replaceState(null, '', `#${id}`);
        }
      }
    );
  }
</script>

{% stylesheet %}
  .faq-editorial {
    display: block;
    padding-block: var(--faq-padding-top) var(--faq-padding-bottom);
    background: var(--faq-background);
    color: var(--faq-text);
    font-family: var(--font-body--family);
  }

  .faq-editorial__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-inline-size: 1240px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  /* ---------- Sidebar ---------- */
  .faq-editorial__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-end: 24px;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .faq-editorial__picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
    padding: 16px 20px;
    border: 0;
    background: var(--faq-card);
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: 16px;
    letter-spacing: 0.04em;
    text-align: start;
    text-transform: uppercase;
    cursor: pointer;
  }

  .faq-editorial__picker[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .faq-editorial__menu {
    display: none;
    margin-block-start: 1px;
  }

  .faq-editorial__picker[aria-expanded='true'] + .faq-editorial__menu {
    display: block;
  }

  /* Sidebar groups: accordion cards with a round icon badge (Hermès) */
  .faq-editorial__group-card {
    background: var(--faq-card);
  }

  .faq-editorial__group-card + .faq-editorial__group-card {
    margin-block-start: 1px;
  }

  .faq-editorial__group {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 57px;
    padding: 8px 24px 8px 24px;
    font-family: var(--font-heading--family);
    font-size: 14px;
    letter-spacing: 0.04em;
    line-height: 22px;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .faq-editorial__group::-webkit-details-marker {
    display: none;
  }

  .faq-editorial__group-icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: var(--faq-background);
  }

  .faq-editorial__group-icon img {
    display: block;
    inline-size: 20px;
    block-size: 20px;
    object-fit: contain;
  }

  .faq-editorial__group-title {
    flex: 1;
  }

  .faq-editorial__chevron {
    flex: none;
    transition: transform 0.3s ease;
  }

  .faq-editorial__group-card[open] .faq-editorial__chevron {
    transform: rotate(180deg);
  }

  .faq-editorial__group-topics-inner {
    padding: 0 24px 12px 26px;
  }

  /* Smooth open/close: the script animates the height of these */
  [data-faq-collapsible] {
    overflow: hidden;
  }

  .faq-editorial__topic {
    display: block;
    inline-size: fit-content;
    padding-block: 8px;
    color: var(--faq-muted);
    opacity: 0.7;
    transition: opacity 0.2s ease;
    font-size: 14px;
    line-height: 22px;
    text-decoration: none;
  }

  .faq-editorial__topic:hover,
  .faq-editorial__topic.is-active {
    opacity: 1;
  }

  .faq-editorial__topic.is-active {
    font-weight: 700;
  }

  /* ---------- Questions ---------- */
  .faq-editorial__content [hidden] {
    display: none;
  }

  .faq-editorial__title {
    margin: 0;
    padding: 24px;
    border-block-end: 1px solid var(--faq-background);
    background: var(--faq-card);
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .faq-editorial__item {
    background: var(--faq-card);
  }

  .faq-editorial__item + .faq-editorial__item {
    margin-block-start: 1px;
  }

  .faq-editorial__item[hidden] + .faq-editorial__item,
  .faq-editorial__title + .faq-editorial__item {
    margin-block-start: 0;
  }

  .faq-editorial__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-block-size: 56px;
    padding: 14px 24px;
    cursor: pointer;
    list-style: none;
  }

  .faq-editorial__question::-webkit-details-marker {
    display: none;
  }

  .faq-editorial__question-text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 22px;
    text-transform: none;
  }

  /* Plus that turns into a minus */
  .faq-editorial__icon {
    position: relative;
    flex: none;
    inline-size: 14px;
    block-size: 14px;
  }

  .faq-editorial__icon::before,
  .faq-editorial__icon::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 1px;
    background: currentColor;
    transition: transform 0.25s ease;
  }

  .faq-editorial__icon::after {
    transform: rotate(90deg);
  }

  .faq-editorial__item[open] .faq-editorial__icon::after {
    transform: rotate(0deg);
  }

  /* The outer box is what animates, so it has no padding (padding can't shrink to 0 smoothly) */
  .faq-editorial__answer-inner {
    padding: 0 24px 24px;
    font-size: 13px;
    line-height: 1.6;
  }

  .faq-editorial__answer-inner > :first-child {
    margin-block-start: 0;
  }

  .faq-editorial__answer-inner > :last-child {
    margin-block-end: 0;
  }

  /* Indented bullet list, like Hermès (also applies to lists pasted into the answer) */
  .faq-editorial__answer-inner ul,
  .faq-editorial__answer-inner ol {
    margin: 12px 0;
    padding-inline-start: 22px;
  }

  .faq-editorial__answer-inner ul {
    list-style: disc;
  }

  .faq-editorial__answer-inner li {
    padding-inline-start: 4px;
  }

  .faq-editorial__answer-inner li + li {
    margin-block-start: 4px;
  }

  .faq-editorial__answer-inner li::marker {
    font-size: 0.9em;
  }

  .faq-editorial__empty {
    padding: 24px;
    background: var(--faq-card);
  }

  /* ---------- Contact box ---------- */
  /* Banner image with the contact box overlapping its bottom (Hermès) */
  .faq-editorial__contact-wrap {
    max-inline-size: 1260px;
    margin: 64px auto 0;
    padding-inline: 16px;
  }

  .faq-editorial__banner {
    display: block;
    inline-size: 100%;
    block-size: calc(var(--faq-banner-height) * 0.6);
    object-fit: cover;
  }

  .faq-editorial__contact-wrap--image .faq-editorial__contact {
    position: relative;
    inline-size: calc(100% - 32px);
    margin-block-start: -48px;
  }

  @media screen and (min-width: 990px) {
    .faq-editorial__contact-wrap {
      padding-inline: 40px;
    }

    .faq-editorial__banner {
      block-size: var(--faq-banner-height);
    }

    .faq-editorial__contact-heading {
      font-size: 34px;
    }

    .faq-editorial__contact-wrap--image .faq-editorial__contact {
      inline-size: 80%;
      margin-block-start: calc(var(--faq-banner-height) * -0.37);
    }
  }

  .faq-editorial__contact {
    display: grid;
    justify-items: center;
    gap: 16px;
    max-inline-size: 1006px;
    margin: 0 auto;
    /* Roomy like Hermès: about 270px tall with the heading and a line of text */
    padding: 88px 24px 72px;
    background: var(--faq-card);
    text-align: center;
  }

  .faq-editorial__contact-heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .faq-editorial__contact-text {
    /* Wide enough that the text stays on one or two lines, like Hermès */
    inline-size: 100%;
    min-inline-size: min(100%, 440px);
    max-inline-size: 560px;
    font-size: 13px;
    line-height: 1.6;
  }

  .faq-editorial__contact-text p {
    margin: 0;
  }

  /* ---------- Contact form ---------- */
  .faq-editorial__form {
    inline-size: 100%;
    max-inline-size: 640px;
    margin-block-start: 8px;
    text-align: start;
  }

  .faq-editorial__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .faq-editorial__field {
    display: grid;
    gap: 6px;
  }

  .faq-editorial__field label {
    font-family: var(--font-heading--family);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .faq-editorial__field input,
  .faq-editorial__field select,
  .faq-editorial__field textarea {
    /* Safari (desktop and iOS) adds its own rounded, shadowed control styles; switch them off */
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
    inline-size: 100%;
    margin: 0;
    padding: 12px 14px;
    line-height: 20px;
    box-shadow: none;
    border: 1px solid color-mix(in srgb, var(--faq-text) 35%, transparent);
    border-radius: 0;
    background: var(--faq-card);
    color: var(--faq-text);
    font: inherit;
    font-size: 14px;
  }

  .faq-editorial__field input,
  .faq-editorial__field select {
    block-size: 46px;
  }

  .faq-editorial__field textarea {
    resize: vertical;
  }

  /* Dropdown: our own single arrow instead of Safari's double arrow */
  .faq-editorial__select {
    position: relative;
  }

  .faq-editorial__select select {
    padding-inline-end: 40px;
    cursor: pointer;
  }

  .faq-editorial__select::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 16px;
    inline-size: 7px;
    block-size: 7px;
    border-inline-end: 1px solid var(--faq-text);
    border-block-end: 1px solid var(--faq-text);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .faq-editorial__field input::placeholder,
  .faq-editorial__field textarea::placeholder {
    color: var(--faq-text);
    opacity: 0.5;
  }

  .faq-editorial__field :is(input, select, textarea):focus-visible {
    outline: 1px solid var(--faq-text);
    outline-offset: 1px;
  }

  .faq-editorial__form-note {
    margin-block-start: 12px;
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.8;
  }

  .faq-editorial__form-note p {
    margin: 0;
  }

  .faq-editorial__form-submit {
    margin-block-start: 20px;
  }

  .faq-editorial__form-status {
    margin: 0 0 16px;
    padding: 12px 16px;
    border: 1px solid currentColor;
    font-size: 14px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .faq-editorial__fields {
      grid-template-columns: 1fr 1fr;
    }

    .faq-editorial__field--full {
      grid-column: 1 / -1;
    }
  }

  /* Uses the theme's primary button style (Theme settings → Buttons) */
  .faq-editorial__contact-button {
    margin-block-start: 8px;
  }

  /* ---------- "Questions only" layout ---------- */
  .faq-editorial--simple .faq-editorial__inner {
    max-inline-size: var(--faq-simple-width, 900px);
  }

  .faq-editorial--simple .faq-editorial__item + .faq-editorial__title {
    margin-block-start: 24px;
  }

  /* ---------- Desktop: sidebar left, questions right ---------- */
  @media screen and (min-width: 990px) {
    .faq-editorial:not(.faq-editorial--simple) .faq-editorial__inner {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: var(--faq-column-gap);
      padding-inline: 40px;
    }

    .faq-editorial__sidebar {
      position: sticky;
      inset-block-start: 32px;
      align-self: start;
    }

    .faq-editorial__picker {
      display: none;
    }

    .faq-editorial__menu {
      display: block;
      padding: 0;
      background: none;
    }
  }
{% endstylesheet %}

