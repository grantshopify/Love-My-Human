{%- comment -%}
  Story collage ("Our story"): three tilted photos like a scrapbook next to the story and a button.
  The photos spread apart a little on hover. On phones the collage sits above the text.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  if s.animate
    assign reveal = 'data-reveal'
  endif
-%}

{%- if s.animate -%}{% render 'editorial-reveal' %}{%- endif -%}

<div
  class="sc sc--images-{{ s.image_position }}"
  style="
    --sc-background: {{ s.background_color | default: settings.color_palette.background }};
    --sc-accent: {{ s.accent_color | default: settings.color_palette.foreground }};
    --sc-text: {{ s.text_color | default: settings.color_palette.color1 }};
    --sc-button-text: {{ s.button_text_color | default: settings.color_palette.background }};
    --sc-heading-size: {{ s.heading_size }}px;
    --sc-height: {{ s.collage_height }}px;
    --sc-width: {{ s.max_width }}px;
    --sc-padding-top: {{ s.padding_top }}px;
    --sc-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="sc__inner">
    <div class="sc__collage">
      {%- for i in (1..3) -%}
        {%- assign key = 'image_' | append: i -%}
        {%- assign image = s[key] -%}
        <div class="sc__photo sc__photo--{{ i }}" {{ reveal }}>
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 1000
              | image_tag:
                class: 'sc__image',
                loading: 'lazy',
                widths: '300, 450, 600, 800, 1000',
                sizes: '(min-width: 750px) 30vw, 60vw'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'sc__image sc__image--placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="sc__content">
      {%- if s.eyebrow != blank -%}
        <p class="sc__eyebrow" {{ reveal }}>{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="sc__heading" {{ reveal }}>{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="sc__text" {{ reveal }}>{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <div {{ reveal }}>
          <a class="sc__button" href="{{ s.button_link }}">{{ s.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sc {
    padding: var(--sc-padding-top) 16px var(--sc-padding-bottom);
    background: var(--sc-background);
    color: var(--sc-text);
    font-family: var(--font-body--family);
  }

  .sc__inner {
    display: grid;
    gap: 32px;
    max-inline-size: var(--sc-width);
    margin: 0 auto;
  }

  /* ---------- Collage ---------- */
  .sc__collage {
    position: relative;
    block-size: calc(var(--sc-height) * 0.68);
  }

  .sc__photo {
    position: absolute;
  }

  .sc__photo--1 {
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 62%;
    block-size: 74%;
  }

  .sc__photo--2 {
    inset-block-start: 12%;
    inset-inline-end: 0;
    inline-size: 48%;
    block-size: 54%;
  }

  .sc__photo--3 {
    inset-block-end: 0;
    inset-inline-start: 26%;
    inline-size: 44%;
    block-size: 46%;
  }

  /* Each photo has a cream border and a slight tilt, like prints on a table */
  .sc__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border: 6px solid var(--sc-background);
    border-radius: 14px;
    object-fit: cover;
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.45);
    transform: rotate(var(--sc-tilt, 0deg));
    transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
  }

  .sc__image--placeholder {
    background: color-mix(in srgb, var(--sc-accent) 12%, #fff);
    fill: var(--sc-accent);
  }

  .sc__photo--1 .sc__image {
    --sc-tilt: -3deg;
  }

  .sc__photo--2 .sc__image {
    --sc-tilt: 4deg;
  }

  .sc__photo--3 .sc__image {
    --sc-tilt: -1deg;
  }

  @media (hover: hover) {
    .sc__collage:hover .sc__photo--1 .sc__image {
      transform: rotate(-5deg) translate(-6px, -4px);
    }

    .sc__collage:hover .sc__photo--2 .sc__image {
      transform: rotate(6deg) translate(6px, -4px);
    }

    .sc__collage:hover .sc__photo--3 .sc__image {
      transform: rotate(-2deg) translateY(6px);
    }
  }

  /* ---------- Text ---------- */
  .sc__content {
    align-self: center;
  }

  .sc__eyebrow {
    margin: 0 0 8px;
    color: var(--sc-accent);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .sc__heading {
    margin: 0 0 16px;
    color: var(--sc-accent);
    font-family: var(--font-heading--family);
    font-size: min(calc(var(--sc-heading-size) * 0.75), 36px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .sc__text {
    max-inline-size: 480px;
    margin-block-end: 24px;
    font-size: 15px;
    line-height: 1.65;
  }

  .sc__text > * {
    margin: 0 0 12px;
  }

  .sc__text > :last-child {
    margin-block-end: 0;
  }

  .sc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 999px;
    background: var(--sc-accent);
    color: var(--sc-button-text);
    font-family: var(--font-heading--family);
    font-size: 14px;
    letter-spacing: 0.12em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .sc__button:hover {
    opacity: 0.85;
  }

  .sc__button:focus-visible {
    outline: 2px solid var(--sc-accent);
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .sc {
      padding-block: min(var(--sc-padding-top), 48px) min(var(--sc-padding-bottom), 48px);
    }
  }

  @media screen and (min-width: 750px) {
    .sc {
      padding-inline: 24px;
    }

    .sc__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 56px;
      align-items: center;
    }

    /* Photos on the right: swap the columns */
    .sc--images-right .sc__collage {
      order: 2;
    }

    .sc__collage {
      block-size: var(--sc-height);
    }

    .sc__image {
      border-width: 8px;
    }

    .sc__heading {
      font-size: min(var(--sc-heading-size), 44px);
    }

    .sc__text {
      font-size: 16px;
    }
  }

  @media screen and (min-width: 990px) {
    .sc__heading {
      font-size: var(--sc-heading-size);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story collage",
  "tag": "section",
  "class": "story-collage-section",
  "settings": [
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Large photo"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second photo"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Third photo"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photos on desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "collage_height",
      "label": "Collage height on desktop",
      "info": "Phones use about two thirds of this.",
      "min": 360,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A townhouse full of dogs"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Grooming, day-care, a grooming academy and a shop: everything at Love My Human is chosen, tested and loved by the dogs who spend their days with us in Chelsea.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Also the colour of the photo borders.",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading and button",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Story collage",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
