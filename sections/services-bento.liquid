{%- comment -%}
  Services bento ("What we do"): the first service gets the big tile and the rest fit around it,
  each with a small label chip, the name and an arrow. Everything is visible at once, no carousel.
  Works with 1 to 5 services; the layout adjusts to the number of tiles.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign count = section.blocks.size

  if s.animate
    assign reveal = 'data-reveal'
  endif

  # Only an arrow link when both a label and a link are set
  assign show_link = false
  if s.link_label != blank and s.link != blank
    assign show_link = true
  endif
-%}

{%- if s.animate -%}{% render 'editorial-reveal' %}{%- endif -%}

<div
  class="hs hs--count-{{ count }}"
  style="
    --hs-background: {{ s.background_color | default: settings.color_palette.background }};
    --hs-accent: {{ s.accent_color | default: settings.color_palette.foreground }};
    --hs-chip: {{ s.chip_color | default: settings.color_palette.background }};
    --hs-heading-size: {{ s.heading_size }}px;
    --hs-title-size: {{ s.title_size }}px;
    --hs-row: {{ s.tile_height }}px;
    --hs-row-mobile: {{ s.tile_height_mobile }}px;
    --hs-gap: {{ s.gap }}px;
    --hs-radius: {{ s.radius }}px;
    --hs-width: {{ s.max_width }}px;
    --hs-padding-top: {{ s.padding_top }}px;
    --hs-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="hs__inner">
    {%- if s.eyebrow != blank or s.heading != blank or show_link -%}
      <div class="hs__intro" {{ reveal }}>
        <div>
          {%- if s.eyebrow != blank -%}
            <p class="hs__eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="hs__heading">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if show_link -%}
          <a class="hs__more" href="{{ s.link }}">
            {{- s.link_label -}}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-5-5 5 5-5 5"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="hs__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          # The big first tile needs a larger image than the others
          if forloop.first
            assign sizes = '(min-width: 750px) 45vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 30vw, 50vw'
          endif
        -%}
        <li class="hs__tile" {{ reveal }} {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}
            <a class="hs__card" href="{{ b.link }}">
          {%- else -%}
            <div class="hs__card">
          {%- endif -%}
            {%- if b.image != blank -%}
              {{
                b.image
                | image_url: width: 1600
                | image_tag:
                  class: 'hs__image',
                  loading: 'lazy',
                  alt: b.title,
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: sizes
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'hs__image hs__image--placeholder' }}
            {%- endif -%}
            {%- if b.chip != blank -%}
              <span class="hs__chip">{{ b.chip }}</span>
            {%- endif -%}
            <span class="hs__text">
              <span class="hs__title">{{ b.title }}</span>
              {%- if b.text != blank -%}
                <span class="hs__line">{{ b.text }}</span>
              {%- endif -%}
            </span>
            {%- if b.link != blank -%}
              <span class="hs__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-5-5 5 5-5 5"/></svg>
              </span>
            {%- endif -%}
          {%- if b.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .hs {
    padding: var(--hs-padding-top) 16px var(--hs-padding-bottom);
    background: var(--hs-background);
    font-family: var(--font-body--family);
  }

  .hs__inner {
    max-inline-size: var(--hs-width);
    margin: 0 auto;
  }

  .hs__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-block-end: 24px;
  }

  .hs__eyebrow {
    margin: 0 0 6px;
    color: var(--hs-accent);
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .hs__heading {
    margin: 0;
    color: var(--hs-accent);
    font-family: var(--font-heading--family);
    /* Big headings scale down on phones so they stay on one line */
    font-size: min(calc(var(--hs-heading-size) * 0.85), 30px);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  /* "All services": an underline that slides away on hover */
  .hs__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-block-end: 4px;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
    color: var(--hs-accent);
    font-family: var(--font-heading--family);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-size 0.5s cubic-bezier(0.2, 0, 0, 1);
  }

  .hs__more:hover {
    background-position: right bottom;
    background-size: 0 1px;
  }

  .hs__more svg {
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1);
  }

  .hs__more:hover svg {
    transform: translateX(4px);
  }

  /* Phones: the first tile runs full width and two rows tall, the rest sit two across */
  .hs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: var(--hs-row-mobile);
    gap: var(--hs-gap);
    margin: 0;
    padding: 0;
  }

  .hs__tile:first-child {
    grid-column: 1 / -1;
    grid-row: span 2;
  }

  /* An odd tile out at the end runs full width rather than leaving a gap */
  .hs--count-2 .hs__tile:nth-child(2),
  .hs--count-4 .hs__tile:nth-child(4) {
    grid-column: 1 / -1;
  }

  .hs__tile {
    min-inline-size: 0;
  }

  .hs__card {
    position: relative;
    display: block;
    block-size: 100%;
    overflow: hidden;
    border-radius: var(--hs-radius);
    background: var(--hs-accent);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .hs__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0, 0, 1);
  }

  .hs__image--placeholder {
    background: color-mix(in srgb, var(--hs-accent) 15%, #fff);
    fill: var(--hs-accent);
  }

  /* Shade the bottom so the white names stay readable on any photo */
  .hs__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 50%);
    pointer-events: none;
  }

  .hs__chip {
    position: absolute;
    z-index: 1;
    inset-block-start: 14px;
    inset-inline-start: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--hs-chip);
    color: var(--hs-accent);
    font-family: var(--font-heading--family);
    font-size: 11px;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hs__text {
    position: absolute;
    z-index: 1;
    inset-inline: 16px 60px;
    inset-block-end: 16px;
    display: grid;
    gap: 4px;
  }

  .hs__title {
    font-family: var(--font-heading--family);
    font-size: calc(var(--hs-title-size) * 0.8);
    letter-spacing: 0.03em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .hs__tile:first-child .hs__title {
    font-size: var(--hs-title-size);
  }

  .hs__line {
    font-size: 14px;
    line-height: 1.4;
  }

  .hs__arrow {
    position: absolute;
    z-index: 1;
    inset-inline-end: 14px;
    inset-block-end: 14px;
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    background: var(--hs-chip);
    color: var(--hs-accent);
    transition:
      transform 0.4s cubic-bezier(0.2, 0, 0, 1),
      background-color 0.3s ease,
      color 0.3s ease;
  }

  @media (hover: hover) {
    .hs__card:hover .hs__image {
      transform: scale(1.05);
    }

    .hs__card:hover .hs__arrow {
      background: var(--hs-accent);
      color: var(--hs-chip);
      transform: translateX(-4px);
    }
  }

  .hs__card:focus-visible {
    outline: 2px solid var(--hs-accent);
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .hs {
      padding-block: min(var(--hs-padding-top), 48px) min(var(--hs-padding-bottom), 48px);
    }

    .hs__line {
      display: none;
    }

    .hs__tile:not(:first-child) .hs__text {
      inset-inline: 12px 52px;
      inset-block-end: 12px;
    }

    .hs__tile:not(:first-child) .hs__title {
      font-size: min(calc(var(--hs-title-size) * 0.65), 22px);
    }

    .hs__tile:not(:first-child) .hs__arrow {
      inset-inline-end: 10px;
      inset-block-end: 10px;
      inline-size: 32px;
      block-size: 32px;
    }

    .hs__tile:not(:first-child) .hs__chip {
      inset-block-start: 10px;
      inset-inline-start: 10px;
    }
  }

  /* Tablet and up: the first tile fills the left column, two rows tall */
  @media screen and (min-width: 750px) {
    .hs {
      padding-inline: 24px;
    }

    .hs__intro {
      margin-block-end: 32px;
    }

    .hs__heading {
      font-size: min(var(--hs-heading-size), 40px);
    }

    .hs__grid {
      grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, var(--hs-row));
      grid-auto-rows: var(--hs-row);
    }

    .hs__tile:first-child {
      grid-column: auto;
    }

    .hs--count-1 .hs__grid {
      grid-template-columns: 1fr;
    }

    .hs--count-2 .hs__grid,
    .hs--count-3 .hs__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }

    .hs--count-2 .hs__tile:nth-child(2) {
      grid-column: auto;
      grid-row: span 2;
    }

    .hs--count-4 .hs__tile:nth-child(4) {
      grid-column: span 2;
    }

    .hs__text {
      inset-inline: 20px 72px;
      inset-block-end: 18px;
    }
  }

  @media screen and (min-width: 990px) {
    .hs__heading {
      font-size: var(--hs-heading-size);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs__image,
    .hs__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Services bento",
  "tag": "section",
  "class": "services-bento-section",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Book a dog groom"
        },
        {
          "type": "text",
          "id": "chip",
          "label": "Label",
          "default": "Book now",
          "info": "The small tag in the top corner. Leave empty to hide it."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line",
          "info": "Optional, shown under the name on tablet and desktop."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "The first service gets the big tile. Works best with 4 services."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "The Townhouse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we do"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Service name size",
      "info": "For the big tile; the smaller tiles are a little smaller.",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All services",
      "info": "Shown next to the heading. Needs a link."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "tile_height",
      "label": "Row height on desktop",
      "min": 180,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "tile_height_mobile",
      "label": "Row height on mobile",
      "min": 120,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading and arrows",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "chip_color",
      "label": "Labels and arrow circles",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Services bento",
      "category": "t:categories.storytelling",
      "blocks": [
        { "type": "service", "settings": { "title": "Book a dog groom", "chip": "Book now" } },
        { "type": "service", "settings": { "title": "Doggy day-care", "chip": "Daily" } },
        { "type": "service", "settings": { "title": "Grooming academy", "chip": "Courses" } },
        { "type": "service", "settings": { "title": "Wholesale", "chip": "Trade" } }
      ]
    }
  ]
}
{% endschema %}
