{%- comment -%}
  Editorial video (Hermès "story behind" style): a centred title and short text,
  then a large video that plays muted on a loop with slim controls along the bottom.
  Uses an uploaded video (with a different one for mobile if you like), or a YouTube / Vimeo link,
  or just an image.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # Colours: two presets from the theme palette, or the custom pickers
  assign palette = settings.color_palette
  case s.color_style
    when 'neutral'
      assign ev_background = palette.background
      assign ev_heading = palette.color1
      assign ev_text = palette.color1
    when 'custom'
      assign ev_background = s.background_color
      assign ev_heading = s.heading_color
      assign ev_text = s.text_color
    else
      assign ev_background = palette.background
      assign ev_heading = palette.foreground
      assign ev_text = palette.foreground
  endcase

  case s.aspect_ratio
    when 'wide'
      assign ratio = '21 / 9'
    when 'classic'
      assign ratio = '4 / 3'
    when 'square'
      assign ratio = '1 / 1'
    else
      assign ratio = '16 / 9'
  endcase
  case s.aspect_ratio_mobile
    when 'square'
      assign ratio_mobile = '1 / 1'
    when 'landscape'
      assign ratio_mobile = '16 / 9'
    when 'tall'
      assign ratio_mobile = '9 / 16'
    else
      assign ratio_mobile = '3 / 4'
  endcase

  # Scroll animation: the text fades up and the video opens out from the middle
  if s.animate
    assign reveal = 'data-reveal'
    assign reveal_clip = 'data-reveal="clip"'
  endif

  # A video the page plays itself (uploaded, or an MP4 link) gets the Hermès-style controls
  assign has_file_video = false
  if s.video != blank or s.video_file != blank
    assign has_file_video = true
  endif
-%}

{%- if s.animate -%}{% render 'editorial-reveal' %}{%- endif -%}

<editorial-video
  class="ev{% if s.full_width_mobile %} ev--bleed-mobile{% endif %}"
  data-autoplay="{{ s.autoplay }}"
  style="
    --ev-background: {{ ev_background }};
    --ev-heading: {{ ev_heading }};
    --ev-text: {{ ev_text }};
    --ev-ratio: {{ ratio }};
    --ev-ratio-mobile: {{ ratio_mobile }};
    --ev-width: {{ s.max_width }}px;
    --ev-heading-size: {{ s.heading_size }}px;
    --ev-padding-top: {{ s.padding_top }}px;
    --ev-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  {%- if s.heading != blank or s.text != blank or s.eyebrow != blank -%}
    <div class="ev__intro" {{ reveal }}>
      {%- if s.eyebrow != blank -%}
        <p class="ev__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="ev__heading{% if s.heading_uppercase %} ev__heading--upper{% endif %}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="ev__text">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="ev__link" href="{{ s.button_link | default: '#' }}">
          <span>{{ s.button_label }}</span>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-5-5 5 5-5 5"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ev__media" {{ reveal_clip }}>
    {%- if has_file_video -%}
      {%- comment -%} Autoplay is started by the script, so only the video for the current screen size plays {%- endcomment -%}
      {%- capture video_class -%}ev__video{% if s.video_mobile != blank %} ev__video--desktop{% endif %}{%- endcapture -%}
      {%- if s.video != blank -%}
        {{
          s.video
          | video_tag:
            image_size: '1920x',
            autoplay: false,
            loop: s.loop,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            class: video_class
        }}
      {%- else -%}
        <video
          class="{{ video_class }}"
          src="{{ s.video_file }}"
          {% if s.image != blank %}
            poster="{{ s.image | image_url: width: 1920 }}"
          {% endif %}
          {% if s.loop %}
            loop
          {% endif %}
          muted
          playsinline
          preload="metadata"
        ></video>
      {%- endif -%}
      {%- if s.video_mobile != blank -%}
        {{
          s.video_mobile
          | video_tag:
            image_size: '1080x',
            autoplay: false,
            loop: s.loop,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            class: 'ev__video ev__video--mobile'
        }}
      {%- endif -%}

      {%- if s.show_controls -%}
        <div class="ev__controls">
          <button type="button" class="ev__control" data-ev-play aria-label="Play">
            <svg class="ev__icon-play" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5.5v13l10.5-6.5L8 5.5Z"/></svg>
            <svg class="ev__icon-pause" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M7.5 5.5h3v13h-3zM13.5 5.5h3v13h-3z"/></svg>
          </button>
          <button type="button" class="ev__control" data-ev-mute aria-label="Unmute">
            <svg class="ev__icon-muted" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4v-5Z" fill="currentColor"/><path d="m15.5 9.5 5 5m0-5-5 5" stroke-linecap="round"/></svg>
            <svg class="ev__icon-sound" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4v-5Z" fill="currentColor"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" stroke-linecap="round"/></svg>
          </button>
          <div class="ev__progress" data-ev-progress role="slider" tabindex="0" aria-label="Video progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="ev__progress-bar" data-ev-bar></span>
          </div>
          <span class="ev__time" data-ev-time>0:00</span>
          <button type="button" class="ev__control" data-ev-fullscreen aria-label="Full screen">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>
          </button>
        </div>
      {%- endif -%}
    {%- elsif s.video_url != blank -%}
      {%- liquid
        if s.video_url.type == 'youtube'
          assign video_src = 'https://www.youtube.com/embed/' | append: s.video_url.id | append: '?rel=0&playsinline=1'
          if s.autoplay
            assign video_src = video_src | append: '&autoplay=1&mute=1'
          endif
          if s.loop
            assign video_src = video_src | append: '&loop=1&playlist=' | append: s.video_url.id
          endif
        else
          assign video_src = 'https://player.vimeo.com/video/' | append: s.video_url.id | append: '?dnt=1'
          if s.autoplay
            assign video_src = video_src | append: '&autoplay=1&muted=1'
          endif
          if s.loop
            assign video_src = video_src | append: '&loop=1'
          endif
        endif
      -%}
      <iframe
        class="ev__iframe"
        src="{{ video_src }}"
        title="{{ s.heading | default: 'Video' | escape }}"
        allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    {%- elsif s.image != blank -%}
      {{
        s.image
        | image_url: width: 2400
        | image_tag:
          class: 'ev__image',
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 750px) min(100vw - 48px, var(--ev-width)), 100vw'
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'ev__image ev__placeholder' }}
    {%- endif -%}
  </div>

  {%- if s.caption != blank -%}
    <div class="ev__caption">{{ s.caption }}</div>
  {%- endif -%}
</editorial-video>

{%- if has_file_video -%}
  <script>
    if (!customElements.get('editorial-video')) {
      customElements.define(
        'editorial-video',
        class extends HTMLElement {
          connectedCallback() {
            this.videos = [...this.querySelectorAll('video')];
            this.play = this.querySelector('[data-ev-play]');
            this.mute = this.querySelector('[data-ev-mute]');
            this.progress = this.querySelector('[data-ev-progress]');
            this.bar = this.querySelector('[data-ev-bar]');
            this.time = this.querySelector('[data-ev-time]');
            this.fullscreen = this.querySelector('[data-ev-fullscreen]');

            this.play?.addEventListener('click', () => (this.video.paused ? this.video.play() : this.video.pause()));
            this.mute?.addEventListener('click', () => {
              this.video.muted = !this.video.muted;
              this.update();
            });
            this.fullscreen?.addEventListener('click', () => {
              const video = this.video;
              if (video.requestFullscreen) video.requestFullscreen();
              else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen(); // iPhone Safari
            });
            this.progress?.addEventListener('click', (event) => {
              const rect = this.progress.getBoundingClientRect();
              const ratio = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
              if (this.video.duration) this.video.currentTime = ratio * this.video.duration;
            });
            this.progress?.addEventListener('keydown', (event) => {
              if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
              event.preventDefault();
              this.video.currentTime += event.key === 'ArrowRight' ? 5 : -5;
            });

            this.videos.forEach((video) =>
              ['play', 'pause', 'timeupdate', 'loadedmetadata', 'volumechange'].forEach((type) =>
                video.addEventListener(type, () => video === this.video && this.update())
              )
            );

            // Only the video for the current screen size plays; the other one stays paused
            this.query = window.matchMedia('(min-width: 750px)');
            this.query.addEventListener('change', () => this.pick());

            // Play while on screen, pause when scrolled away (saves battery and data)
            this.observer = new IntersectionObserver(
              ([entry]) => {
                this.visible = entry.isIntersecting;
                if (this.dataset.autoplay !== 'true') return;
                if (entry.isIntersecting && !this.userPaused) this.video.play().catch(() => {});
                else if (!entry.isIntersecting) this.video.pause();
              },
              { threshold: 0.25 }
            );
            this.observer.observe(this);

            this.play?.addEventListener('click', () => (this.userPaused = !this.video.paused));
            this.pick();
          }

          disconnectedCallback() {
            this.observer?.disconnect();
          }

          get video() {
            return this.videos.find((video) => video.offsetParent !== null) || this.videos[0];
          }

          pick() {
            const current = this.video;
            this.videos.forEach((video) => video !== current && video.pause());
            if (this.dataset.autoplay === 'true' && this.visible && !this.userPaused) current.play().catch(() => {});
            this.update();
          }

          update() {
            const video = this.video;
            if (!video) return;
            this.classList.toggle('is-playing', !video.paused);
            this.classList.toggle('is-muted', video.muted);
            this.play?.setAttribute('aria-label', video.paused ? 'Play' : 'Pause');
            this.mute?.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
            const percent = video.duration ? (video.currentTime / video.duration) * 100 : 0;
            if (this.bar) this.bar.style.transform = `scaleX(${percent / 100})`;
            this.progress?.setAttribute('aria-valuenow', String(Math.round(percent)));
            if (this.time && video.duration) {
              // Time left, like Hermès
              const left = Math.max(0, Math.ceil(video.duration - video.currentTime));
              this.time.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
            }
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .ev {
    display: block;
    padding: var(--ev-padding-top) 15px var(--ev-padding-bottom);
    background: var(--ev-background);
    color: var(--ev-text);
    font-family: var(--font-body--family);
  }

  .ev__intro {
    max-inline-size: 628px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .ev__eyebrow {
    margin: 0 0 10px;
    color: var(--ev-heading);
    font-family: var(--font-heading--family);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Short rules either side of the label, like an editorial masthead */
  .ev__eyebrow::before,
  .ev__eyebrow::after {
    content: '';
    display: inline-block;
    inline-size: 24px;
    block-size: 1px;
    margin-inline: 12px;
    background: currentColor;
    vertical-align: middle;
    opacity: 0.6;
  }

  .ev__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 20px;
    padding-block-end: 4px;
    color: var(--ev-heading);
    font-family: var(--font-heading--family);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
    transition: background-size 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .ev__link:hover {
    background-size: 0 1px;
    background-position: right bottom;
  }

  .ev__link svg {
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1);
  }

  .ev__link:hover svg {
    transform: translateX(5px);
  }

  .ev__heading {
    margin: 0 0 8px;
    color: var(--ev-heading);
    font-family: var(--font-heading--family);
    font-size: calc(var(--ev-heading-size) * 0.85);
    font-weight: 400;
    line-height: 1.2;
    text-transform: none;
  }

  .ev__heading--upper {
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ev__text {
    font-size: 16px;
    line-height: 1.5;
  }

  .ev__text p {
    margin: 0;
  }

  .ev__media {
    position: relative;
    overflow: hidden;
    max-inline-size: var(--ev-width);
    margin: 0 auto;
    aspect-ratio: var(--ev-ratio-mobile);
    background: color-mix(in srgb, var(--ev-text) 8%, transparent);
  }

  .ev--bleed-mobile .ev__media {
    margin-inline: -15px;
  }

  .ev__video,
  .ev__image,
  .ev__iframe {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    object-fit: cover;
  }

  .ev__placeholder {
    fill: color-mix(in srgb, var(--ev-text) 25%, transparent);
  }

  .ev__video--desktop {
    display: none;
  }

  /* A very slow push-in while the video plays */
  .ev__video {
    transform: scale(1.0001);
    transition: transform 12s linear;
  }

  .ev.is-playing .ev__video {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .ev__video,
    .ev.is-playing .ev__video {
      transform: none;
      transition: none;
    }
  }

  /* Hermès-style controls: a thin bar over the bottom of the video */
  .ev__controls {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 32px 16px 12px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), transparent);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ev__media:hover .ev__controls,
  .ev__controls:focus-within,
  .ev:not(.is-playing) .ev__controls {
    opacity: 1;
  }

  @media (hover: none) {
    .ev__controls {
      opacity: 1;
    }
  }

  .ev__control {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .ev__control:focus-visible,
  .ev__progress:focus-visible {
    outline: 1px solid #fff;
    outline-offset: 2px;
  }

  .ev__icon-pause,
  .ev.is-playing .ev__icon-play,
  .ev__icon-sound,
  .ev:not(.is-muted) .ev__icon-muted {
    display: none;
  }

  .ev.is-playing .ev__icon-pause,
  .ev:not(.is-muted) .ev__icon-sound {
    display: block;
  }

  .ev__progress {
    position: relative;
    flex: 1;
    block-size: 16px;
    cursor: pointer;
  }

  .ev__progress::before,
  .ev__progress-bar {
    content: '';
    position: absolute;
    inset: 7px 0 auto;
    block-size: 2px;
    background: rgb(255 255 255 / 0.35);
  }

  .ev__progress-bar {
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .ev__time {
    flex: none;
    min-inline-size: 32px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .ev__caption {
    max-inline-size: var(--ev-width);
    margin: 12px auto 0;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  .ev__caption p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ev {
      padding-inline: 24px;
    }

    .ev__intro {
      margin-block-end: 40px;
    }

    .ev__heading {
      font-size: var(--ev-heading-size);
    }

    .ev__text {
      font-size: 18px;
    }

    .ev__media,
    .ev--bleed-mobile .ev__media {
      margin-inline: auto;
      aspect-ratio: var(--ev-ratio);
    }

    .ev__video--desktop {
      display: block;
    }

    .ev__video--mobile {
      display: none;
    }

    .ev__controls {
      gap: 16px;
      padding-inline: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ev {
      padding-block: min(var(--ev-padding-top), 48px) min(var(--ev-padding-bottom), 48px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial video",
  "tag": "section",
  "class": "editorial-video-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Love My Human story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A short line that introduces the video. Keep it to one or two sentences.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Discover our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload an MP4. It plays muted on a loop, with play, sound, progress and full screen controls."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video",
      "info": "Optional. A portrait cut for phones."
    },
    {
      "type": "url",
      "id": "video_file",
      "label": "Or video file link (MP4)",
      "info": "Used when no video is uploaded above, e.g. a video from Content > Files. Gets the same controls."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or YouTube / Vimeo link",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Only used when there is no uploaded video or MP4 link."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown when there is no video. Also used as the cover image for an MP4 link."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (muted)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on scroll",
      "info": "The text fades up and the video opens out as it comes into view.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": true
    },
    {
      "type": "richtext",
      "id": "caption",
      "label": "Caption under the video"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Shape on desktop",
      "options": [
        {
          "value": "landscape",
          "label": "Landscape (16:9)"
        },
        {
          "value": "wide",
          "label": "Wide (21:9)"
        },
        {
          "value": "classic",
          "label": "Classic (4:3)"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Shape on mobile",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "tall",
          "label": "Tall (9:16)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape (16:9)"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "full_width_mobile",
      "label": "Edge to edge on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
