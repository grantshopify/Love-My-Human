{%- comment -%}
  Customer reviews: a branded heading over the Reviews.io widget (or a reviews app block).
  The section carries id="reviews", so the star summary under the price scrolls down to it.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  if s.animate
    assign reveal = 'data-reveal'
  endif
-%}

{%- if s.animate -%}{% render 'editorial-reveal' %}{%- endif -%}

<div
  id="{{ s.anchor | default: 'reviews' | handleize }}"
  class="rv"
  style="
    --rv-background: {{ s.background_color | default: settings.color_palette.background }};
    --rv-accent: {{ s.accent_color | default: settings.color_palette.foreground }};
    --rv-text: {{ s.text_color | default: settings.color_palette.color1 }};
    --rv-heading-size: {{ s.heading_size }}px;
    --rv-width: {{ s.max_width }}px;
    --rv-padding-top: {{ s.padding_top }}px;
    --rv-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="rv__inner">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="rv__intro" {{ reveal }}>
        {%- if s.eyebrow != blank -%}
          <p class="rv__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="rv__heading{% if s.heading_rule %} rv__heading--rule{% endif %}">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rv__widget">
      {%- comment -%} Reviews.io (Zac 26 Nov): with a Reviews.io store ID set, its widget replaces the app blocks {%- endcomment -%}
      {%- if s.reviewsio_store != blank and product != blank -%}
        {%- assign rv_accent = s.accent_color | default: settings.color_palette.foreground -%}
        {% render 'lmh-reviewsio-widget', product: product, store: s.reviewsio_store, accent: rv_accent %}
      {%- else -%}
        {% content_for 'blocks' %}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rv {
    padding: var(--rv-padding-top) 16px var(--rv-padding-bottom);
    background: var(--rv-background);
    color: var(--rv-text);
    font-family: var(--font-body--family);
    scroll-margin-top: 120px;
  }

  .rv__inner {
    max-inline-size: var(--rv-width);
    margin: 0 auto;
  }

  .rv__intro {
    margin-block-end: 32px;
    text-align: center;
  }

  .rv__eyebrow {
    margin: 0 0 8px;
    color: var(--rv-accent);
    font-family: var(--font-heading--family);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .rv__eyebrow::before,
  .rv__eyebrow::after {
    content: '';
    display: inline-block;
    inline-size: 24px;
    block-size: 1px;
    margin-inline: 12px;
    background: currentColor;
    vertical-align: middle;
    opacity: 0.6;
  }

  .rv__heading {
    margin: 0;
    color: var(--rv-accent);
    font-family: var(--font-heading--family);
    font-size: min(calc(var(--rv-heading-size) * 0.85), 30px);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .rv__heading--rule::after {
    content: '';
    display: block;
    inline-size: 56px;
    block-size: 3px;
    margin: 16px auto 0;
    background: currentColor;
  }


  @media screen and (min-width: 750px) {
    .rv {
      padding-inline: 24px;
    }

    .rv__intro {
      margin-block-end: 40px;
    }

    .rv__heading {
      font-size: min(var(--rv-heading-size), 40px);
    }
  }

  @media screen and (min-width: 990px) {
    .rv__heading {
      font-size: var(--rv-heading-size);
    }
  }

  @media screen and (max-width: 749px) {
    .rv {
      padding-block: min(var(--rv-padding-top), 48px) min(var(--rv-padding-bottom), 48px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "reviews-editorial-section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the Reviews.io widget when the store ID below is filled; otherwise add a reviews app block here."
    },
    {
      "type": "text",
      "id": "reviewsio_store",
      "label": "Reviews.io store ID",
      "info": "When filled, product pages show the Reviews.io widget here instead of the app blocks. Your store ID is in Reviews.io > Integrations."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What humans say"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "heading_rule",
      "label": "Short line under the heading",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "reviews",
      "info": "The star summary under the price links to #reviews."
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1080
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Stars, headings and buttons",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Review text",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
