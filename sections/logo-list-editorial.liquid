{%- comment -%}
  Press logos (e.g. "They're talking about"): a centred heading over a grid of logos.
  Logos are fitted to the same height so a row looks even, whatever their shape.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # Colours: two presets from the theme palette, or the custom pickers
  assign palette = settings.color_palette
  case s.color_style
    when 'neutral'
      assign ll_background = palette.background
      assign ll_heading = palette.color1
      assign ll_text = palette.color1
    when 'custom'
      assign ll_background = s.background_color
      assign ll_heading = s.heading_color
      assign ll_text = s.text_color
    else
      assign ll_background = palette.background
      assign ll_heading = palette.foreground
      assign ll_text = palette.color1
  endcase

  # Scroll animation: the logos fade up one after another
  if s.animate
    assign reveal = 'data-reveal'
  endif

  # Slider: a set number of logos at a time, with arrows (and swipe) to move to the next set
  assign slider = false
  if s.layout == 'slider'
    assign slider = true
  endif
  # The mobile ticker only applies to the grid layout
  assign ticker = false
  if s.mobile_marquee and slider == false
    assign ticker = true
  endif
-%}

{%- if s.animate -%}{% render 'editorial-reveal' %}{%- endif -%}

<div
  class="ll{% if s.grayscale %} ll--grayscale{% endif %}{% if ticker %} ll--marquee{% endif %}{% if slider %} ll--slider{% endif %}{% if s.heading_rule %} ll--rule{% endif %}"
  style="
    --ll-background: {{ ll_background }};
    --ll-heading: {{ ll_heading }};
    --ll-text: {{ ll_text }};
    --ll-columns: {{ s.columns_desktop }};
    --ll-columns-mobile: {{ s.columns_mobile }};
    --ll-per-page: {{ s.per_page }};
    --ll-per-page-mobile: {{ s.per_page_mobile }};
    --ll-logo-height: {{ s.logo_height }}px;
    --ll-logo-height-mobile: {{ s.logo_height_mobile }}px;
    --ll-logo-width: {{ s.logo_width }}px;
    --ll-width: {{ s.max_width }}px;
    --ll-heading-size: {{ s.heading_size }}px;
    --ll-padding-top: {{ s.padding_top }}px;
    --ll-padding-bottom: {{ s.padding_bottom }}px;
    --ll-speed: {{ s.marquee_speed }}s;
  "
>
  <div class="ll__inner">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="ll__intro" {{ reveal }}>
        {%- if s.eyebrow != blank -%}
          <p class="ll__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="ll__heading">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Each logo is built once, then used in the list and, for the mobile ticker, in its copy {%- endcomment -%}
    {%- capture logos -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="ll__item" {{ reveal }} {{ block.shopify_attributes }}>
        {%- if b.link != blank -%}
          <a
            class="ll__logo"
            href="{{ b.link }}"
            {% if b.new_tab %}
              target="_blank" rel="noopener"
            {% endif %}
          >
        {%- else -%}
          <span class="ll__logo">
        {%- endif -%}
          {%- if b.image != blank -%}
            {{
              b.image
              | image_url: width: 480
              | image_tag: class: 'll__image', loading: 'lazy', alt: b.name, widths: '160, 240, 320, 480', sizes: '200px'
            }}
          {%- elsif b.theme_image != blank -%}
            <img
              class="ll__image"
              src="{{ b.theme_image | asset_url }}"
              width="300"
              height="120"
              alt="{{ b.name | escape }}"
              loading="lazy"
            >
          {%- else -%}
            {%- comment -%} No logo yet: show the name so the client can picture the row {%- endcomment -%}
            <span class="ll__placeholder">{{ b.name | default: 'Logo' }}</span>
          {%- endif -%}
        {%- if b.link != blank -%}
          </a>
        {%- else -%}
          </span>
        {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if slider -%}
      <logo-slider class="ll__slider">
        <button type="button" class="ll__arrow ll__arrow--prev" data-ll-prev aria-label="Previous logos" disabled>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 5.5-6.5 6.5 6.5 6.5"/></svg>
        </button>
        <ul class="ll__list ll__list--slider list-unstyled" role="list" tabindex="0" aria-label="{{ s.heading | default: 'Press logos' | escape }}" data-ll-list>
          {{- logos -}}
        </ul>
        <button type="button" class="ll__arrow ll__arrow--next" data-ll-next aria-label="Next logos">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 5.5 6.5 6.5-6.5 6.5"/></svg>
        </button>
        <div class="ll__dots" data-ll-dots></div>
      </logo-slider>
    {%- else -%}
      <div class="ll__viewport">
        <div class="ll__track">
          <ul class="ll__list list-unstyled" role="list">
            {{- logos -}}
          </ul>
          {%- if ticker -%}
            <ul class="ll__list ll__list--copy list-unstyled" role="list" aria-hidden="true" inert>
              {{- logos | remove: 'data-reveal' -}}
            </ul>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if slider -%}
  <script>
    if (!customElements.get('logo-slider')) {
      customElements.define(
        'logo-slider',
        class extends HTMLElement {
          connectedCallback() {
            this.list = this.querySelector('[data-ll-list]');
            this.prev = this.querySelector('[data-ll-prev]');
            this.next = this.querySelector('[data-ll-next]');
            this.dots = this.querySelector('[data-ll-dots]');
            this.items = [...this.list.children];

            this.prev.addEventListener('click', () => this.go(-1));
            this.next.addEventListener('click', () => this.go(1));
            this.list.addEventListener('scroll', () => this.update(), { passive: true });
            this.list.addEventListener('keydown', (event) => {
              if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
                event.preventDefault();
                this.go(event.key === 'ArrowRight' ? 1 : -1);
              }
            });
            // Logos per page changes between phone and desktop, so rebuild the dots when the size changes
            this.resizeObserver = new ResizeObserver(() => this.build());
            this.resizeObserver.observe(this.list);
          }

          disconnectedCallback() {
            this.resizeObserver?.disconnect();
          }

          /** Distance from one logo to the next, and how many fit in view */
          measure() {
            const step = this.items.length > 1 ? this.items[1].offsetLeft - this.items[0].offsetLeft : this.list.clientWidth;
            const perPage = Math.max(1, Math.round(this.list.clientWidth / step));
            return { step, perPage, pages: Math.ceil(this.items.length / perPage) };
          }

          build() {
            const { pages } = this.measure();
            this.dots.replaceChildren(
              ...Array.from({ length: pages }, (_, index) => {
                const dot = document.createElement('button');
                dot.type = 'button';
                dot.className = 'll__dot';
                dot.setAttribute('aria-label', `Show logos ${index + 1} of ${pages}`);
                dot.addEventListener('click', () => this.goTo(index));
                return dot;
              })
            );
            this.dots.hidden = pages < 2;
            this.prev.hidden = this.next.hidden = pages < 2;
            this.update();
          }

          go(direction) {
            // Count from the page we are heading to, so quick repeated clicks still move one page each
            const { pages } = this.measure();
            const from = this.target ?? this.current ?? 0;
            this.goTo(Math.min(Math.max(from + direction, 0), pages - 1));
          }

          goTo(index) {
            const { step, perPage } = this.measure();
            this.target = index;
            clearTimeout(this.targetTimer);
            this.targetTimer = setTimeout(() => (this.target = null), 700);
            this.scroll(index * step * perPage);
          }

          scroll(left) {
            const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            this.list.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
          }

          update() {
            const { step, perPage, pages } = this.measure();
            const max = this.list.scrollWidth - this.list.clientWidth;
            const left = this.list.scrollLeft;
            this.prev.disabled = left <= 2;
            this.next.disabled = left >= max - 2;
            const current = left >= max - 2 ? pages - 1 : Math.round(left / (step * perPage));
            this.current = current;
            [...this.dots.children].forEach((dot, index) => {
              if (index === current) dot.setAttribute('aria-current', 'true');
              else dot.removeAttribute('aria-current');
            });
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .ll {
    padding: var(--ll-padding-top) 15px var(--ll-padding-bottom);
    background: var(--ll-background);
    color: var(--ll-text);
    font-family: var(--font-body--family);
  }

  .ll__inner {
    max-inline-size: var(--ll-width);
    margin: 0 auto;
  }

  /* Same heading block as the TV and video sections: label, heading, then 32px (40px on desktop) */
  .ll__intro {
    margin-block-end: 32px;
    text-align: center;
  }

  .ll__eyebrow {
    margin: 0 0 8px;
    color: var(--ll-heading);
    font-family: var(--font-heading--family);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ll__eyebrow::before,
  .ll__eyebrow::after {
    content: '';
    display: inline-block;
    inline-size: 24px;
    block-size: 1px;
    margin-inline: 12px;
    background: currentColor;
    vertical-align: middle;
    opacity: 0.6;
  }

  .ll__heading {
    margin: 0;
    color: var(--ll-heading);
    font-family: var(--font-heading--family);
    /* Big headings scale down on phones so they stay on one or two lines */
    font-size: min(calc(var(--ll-heading-size) * 0.85), 10vw);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
  }

  /* Optional short red line under the heading */
  .ll--rule .ll__heading::after {
    content: '';
    display: block;
    inline-size: 56px;
    block-size: 3px;
    margin: 16px auto 0;
    background: currentColor;
  }

  /* ---------- Slider: a page of logos at a time, arrows either side ---------- */
  .ll__slider {
    --ll-slide-gap: 16px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .ll--slider .ll__list--slider {
    display: grid;
    grid-auto-columns: calc((100% - (var(--ll-per-page-mobile) - 1) * var(--ll-slide-gap)) / var(--ll-per-page-mobile));
    grid-auto-flow: column;
    grid-template-columns: none;
    gap: var(--ll-slide-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .ll--slider .ll__list--slider::-webkit-scrollbar {
    display: none;
  }

  .ll--slider .ll__list--slider:focus-visible {
    outline: 1px solid var(--ll-heading);
    outline-offset: 4px;
  }

  .ll--slider .ll__item {
    scroll-snap-align: start;
  }

  .ll__arrow {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    padding: 0;
    border: 1px solid var(--ll-heading);
    border-radius: 50%;
    background: transparent;
    color: var(--ll-heading);
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.2, 0, 0, 1);
  }

  .ll__arrow:hover:not(:disabled) {
    background: var(--ll-heading);
    color: var(--ll-background);
  }

  .ll__arrow--prev:hover:not(:disabled) {
    transform: translateX(-2px);
  }

  .ll__arrow--next:hover:not(:disabled) {
    transform: translateX(2px);
  }

  .ll__arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .ll__arrow:focus-visible {
    outline: 1px solid var(--ll-heading);
    outline-offset: 3px;
  }

  .ll__dots {
    display: flex;
    grid-column: 2;
    justify-content: center;
    gap: 8px;
    margin-block-start: 16px;
  }

  .ll__dot {
    inline-size: 8px;
    block-size: 8px;
    padding: 0;
    border: 1px solid var(--ll-heading);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition:
      inline-size 0.4s cubic-bezier(0.2, 0, 0, 1),
      background-color 0.3s ease;
  }

  .ll__dot[aria-current='true'] {
    inline-size: 24px;
    background: var(--ll-heading);
  }

  @media screen and (min-width: 750px) {
    .ll__slider {
      --ll-slide-gap: 32px;
      gap: 24px;
    }

    .ll--slider .ll__list--slider {
      grid-auto-columns: calc((100% - (var(--ll-per-page) - 1) * var(--ll-slide-gap)) / var(--ll-per-page));
    }

    .ll__arrow {
      inline-size: 48px;
      block-size: 48px;
    }
  }

  .ll__list {
    display: grid;
    grid-template-columns: repeat(var(--ll-columns-mobile), minmax(0, 1fr));
    gap: 32px 16px;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .ll__item {
    display: flex;
    justify-content: center;
  }

  .ll__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: var(--ll-logo-height-mobile);
    max-inline-size: min(100%, var(--ll-logo-width) * 0.75);
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.2, 0, 0, 1);
  }

  /* Hover: the other logos step back so the one under the pointer stands out */
  @media (hover: hover) {
    .ll__list:hover .ll__logo {
      opacity: 0.35;
    }

    .ll__list .ll__item:hover .ll__logo {
      opacity: 1;
      transform: scale(1.06);
    }

    .ll--grayscale .ll__item:hover .ll__image {
      filter: none;
    }
  }

  .ll__list--copy {
    display: none;
  }

  a.ll__logo:focus-visible {
    outline: 1px solid var(--ll-heading);
    outline-offset: 6px;
  }

  .ll__image {
    display: block;
    inline-size: auto;
    max-inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .ll--grayscale .ll__image {
    filter: grayscale(1);
    transition: filter 0.4s ease;
  }

  /* Mobile ticker: the logos glide past in one line, with soft faded edges. Touch to pause */
  @media screen and (max-width: 989px) and (prefers-reduced-motion: no-preference) {
    .ll--marquee .ll__viewport {
      overflow: hidden;
      margin-inline: -15px;
      mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    }

    @media screen and (min-width: 750px) {
      .ll--marquee .ll__viewport {
        margin-inline: -24px;
      }
    }

    .ll--marquee .ll__track {
      display: flex;
      inline-size: max-content;
      animation: ll-marquee var(--ll-speed, 70s) linear infinite;
    }

    .ll--marquee .ll__viewport:active .ll__track {
      animation-play-state: paused;
    }

    .ll--marquee .ll__list {
      display: flex;
      flex: none;
      gap: 0;
    }

    .ll--marquee .ll__item {
      flex: none;
      padding-inline: 22px;
    }

    .ll--marquee .ll__logo {
      max-inline-size: calc(var(--ll-logo-width) * 0.9);
    }

    /* Logos slide in sideways, so they skip the fade-up (it would only fire as each one enters) */
    .ll--marquee .ll__item.reveal-ready:not(.is-revealed) {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ll-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .ll__placeholder {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .ll {
      padding-inline: 24px;
    }

    .ll__intro {
      margin-block-end: 40px;
    }

    .ll__heading {
      font-size: var(--ll-heading-size);
    }

    .ll__list {
      grid-template-columns: repeat(var(--ll-columns), minmax(0, 1fr));
      gap: 48px 32px;
    }

    .ll__logo {
      block-size: var(--ll-logo-height);
      max-inline-size: min(100%, var(--ll-logo-width));
    }

    .ll__placeholder {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ll {
      padding-block: min(var(--ll-padding-top), 48px) min(var(--ll-padding-bottom), 48px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Press logos",
  "tag": "section",
  "class": "logo-list-section",
  "max_blocks": 30,
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "A PNG with a transparent background or an SVG works best."
        },
        {
          "type": "text",
          "id": "theme_image",
          "label": "Built-in logo",
          "info": "A file already in the theme, used until you pick a logo above. You can leave this as it is."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Publication",
          "info": "Used as the logo description for screen readers."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional, e.g. the article"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in a new tab",
          "default": true
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "In the press"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "They're talking about"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "heading_rule",
      "label": "Short line under the heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Rows"
        },
        {
          "value": "slider",
          "label": "Slider with arrows"
        }
      ],
      "default": "grid",
      "info": "Slider: shows a few logos at a time. Customers click the arrows or swipe to see the next set."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Logos at a time on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "per_page_mobile",
      "label": "Logos at a time on mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Logos per row on desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Logos per row on mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height on desktop",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height on mobile",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Max logo width",
      "info": "Stops long logos (like The Times) looking bigger than the rest.",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 130
    },
    {
      "type": "checkbox",
      "id": "mobile_marquee",
      "label": "Scrolling ticker on mobile and tablet",
      "info": "On phones and tablets the logos glide past in one line instead of stacking in rows.",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Ticker speed",
      "info": "Seconds for one full loop. Lower is faster.",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "s",
      "default": 70,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on scroll",
      "info": "The logos fade up one after another.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in black and white",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1080
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_style",
      "label": "Colour style",
      "options": [
        {
          "value": "brand",
          "label": "Website red (Love My Human)"
        },
        {
          "value": "neutral",
          "label": "Neutral: black on cream (Hermès)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "brand",
