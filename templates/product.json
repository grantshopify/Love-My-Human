      "blocks": {
        "care": {
          "type": "tab",
          "settings": {
            "title": "Care",
            "content": "<p>Look after it and it will look after your dog for years to come.</p><ul><li>Follow the care label on the product</li><li>Brush off hair and dirt regularly</li><li>Spot clean marks with a damp cloth and mild soap</li><li>Wash removable covers on a gentle cycle and air dry</li><li>Keep away from direct heat and strong sunlight</li></ul>",
            "icon": "paw"
          }
        },
        "delivery": {
          "type": "tab",
          "settings": {
            "title": "Delivery & returns",
            "content": "<p><strong>UK delivery</strong></p><ul><li>Orders under £50: Royal Mail 1st Class, £3.50, 2–3 working days</li><li>Orders over £50: courier, £6, 1–2 working days</li><li>Free delivery on orders over £75</li></ul><p><strong>Europe</strong></p><p>Tracked and signed courier from £25. For larger items such as dog beds, email <a href=\"mailto:hello@lovemyhuman.co.uk\">hello@lovemyhuman.co.uk</a> and we will arrange the best way to send them.</p><p><strong>Returns</strong></p><p>Changed your mind? We are happy to refund or exchange non-perishable items within 14 days, as long as they are new, unused and in their original packaging. Personalised and special-order items cannot be returned. This does not affect your statutory rights.</p>",
            "icon": "truck"
          }
        },
        "gifting": {
          "type": "tab",
          "settings": {
            "title": "Gifting",
            "content": "<p>Looking for something ready to give? Our XMAS Hamper is packed with treats and toys chosen by the team.</p><p>[Add your gift message and gift wrapping options here.]</p>",
            "icon": "gift"
