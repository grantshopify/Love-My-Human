    "faq_16": {
      "type": "faq-editorial",
      "blocks": {
        "group_qhv1q1o": {
          "type": "group",
          "settings": {
            "title": "FREQUENTLY ASKED QUESTIONS",
            "icon": "bag",
            "open": true
          }
        },
        "topic_qhv1q1p": {
          "type": "topic",
          "settings": {
            "title": "FREQUENTLY ASKED QUESTIONS"
          }
        },
        "question_qhv1q1q": {
          "type": "question",
          "settings": {
            "question": "How does the enrolment process work?",
            "answer": "<p>We require each dog to attend a one-hour induction to assess their temperament and make sure they that will be happy with us. We will also ask you to complete our application form, sign our terms and conditions and provide proof of your dog’s vaccinations.</p>",
            "bullets": "",
            "answer_after": ""
          }
        },
        "question_qhv1q1r": {
          "type": "question",
          "settings": {
            "question": "Do I have to book in advance?",
            "answer": "<p>Yes, we do require at least 24 hours notice for any daycare bookings. We are very busy so it is best to book in as much advance as possible as certain days are quite popular. If your dog is registered with us, we may have availability on the day, on a walk in basis but this is not guaranteed.</p>",
            "bullets": "",
            "answer_after": ""
          }
        },
        "question_qhv1q1s": {
          "type": "question",
          "settings": {
            "question": "What capacity is the crèche?",
            "answer": "<p>10 dogs at one time.</p>",
            "bullets": "",
            "answer_after": ""
          }
        },
        "question_qhv1q1t": {
          "type": "question",
          "settings": {
            "question": "What if I have a very nervous dog?",
            "answer": "<p>Our fully trained ‘dog-nannies’ are very experienced in looking after dogs that can be shy/nervous and will lovingly pay them extra attention and help them feel as secure as possible.</p>",
            "bullets": "",
            "answer_after": ""
          }
        },
        "question_qhv1q1u": {
          "type": "question",
          "settings": {
            "question": "Do you allow entire male dogs?",
            "answer": "<p>We do allow intact males but this is on a case-by-case basis and they must not display excessive mounting and marking behaviour or aggression.</p>",
            "bullets": "",
            "answer_after": ""
          }
        },
        "question_qhv1q1v": {
          "type": "question",
          "settings": {
            "question": "What if my female is in season?",
            "answer": "<p>Female dogs are not permitted in daycare whilst in season.</p>",
            "bullets": "",
            "answer_after": ""
          }
        }
      },
