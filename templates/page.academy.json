            "text_qle65f": {
              "type": "text",
              "name": "t:names.description",
              "settings": {
                "text": "<p>Perfect for aspiring students who want to gain insight into the grooming world, experience working in a salon and explore what dog grooming &amp; ICMG courses involve.</p><ul><li>4 hours course</li><li>Shadow professional groomers in our salon</li><li>Learn safe dog handling, bathing and drying</li><li>Get hands-on experience</li></ul><p><strong>Bonus:</strong> Get £150 discount off Track 1 within a week of your completion.</p><h3>£150</h3><p><a href=\"https://www.lovemyhuman.co.uk/pages/groomers-taster-course\">LEARN MORE →</a></p>",
